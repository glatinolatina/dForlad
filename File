    icon.Name = "Icon"
    icon.Parent = btn
    icon.BackgroundTransparency = 1
    icon.AnchorPoint = Vector2.new(0.5, 0.5)
    icon.Position = UDim2.new(0.5, 0, 0.5, 0)
    icon.Size = UDim2.new(0, 28, 0, 28)
    icon.Image = "rbxassetid://7733992528"
    icon.ImageColor3 = Color3.fromRGB(240, 240, 240)
    icon.ZIndex = 99999

    -- Drag + Tap logic
    local dragging = false
    local dragOffset = Vector2.new(0, 0)
    local isTap = true
    local touchStart = nil

    btn.InputBegan:Connect(function(input)
        if input.UserInputType ~= Enum.UserInputType.Touch and input.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
        dragging = false
        isTap = true
        touchStart = Vector2.new(input.Position.X, input.Position.Y)
        local absPos = btn.AbsolutePosition
        local absSize = btn.AbsoluteSize
        dragOffset = Vector2.new(
            input.Position.X - (absPos.X + absSize.X / 2),
            input.Position.Y - (absPos.Y + absSize.Y / 2)
        )
        TweenService:Create(btn, TweenInfo.new(0.1), {Size = UDim2.new(0, 50, 0, 50)}):Play()
        TweenService:Create(stroke, TweenInfo.new(0.1), {Color = Color3.fromRGB(140, 140, 140)}):Play()
    end)

    btn.InputChanged:Connect(function(input)
        if not touchStart then return end
        if input.UserInputType ~= Enum.UserInputType.Touch and input.UserInputType ~= Enum.UserInputType.MouseMovement then return end
        local current = Vector2.new(input.Position.X, input.Position.Y)
        if (current - touchStart).Magnitude > 10 then
            isTap = false
            dragging = true
            local vp = workspace.CurrentCamera.ViewportSize
            local nx = math.clamp(input.Position.X - dragOffset.X, 30, vp.X - 30)
            local ny = math.clamp(input.Position.Y - dragOffset.Y, 30, vp.Y - 30)
            btn.Position = UDim2.new(0, nx, 0, ny)
        end
    end)

    btn.InputEnded:Connect(function(input)
        if input.UserInputType ~= Enum.UserInputType.Touch and input.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
        touchStart = nil
        dragging = false
        TweenService:Create(btn, TweenInfo.new(0.15), {Size = UDim2.new(0, 56, 0, 56)}):Play()
        TweenService:Create(stroke, TweenInfo.new(0.15), {Color = Color3.fromRGB(80, 80, 80)}):Play()
        if isTap then
            _G.NaJaToggleUI()
        end
    end)

    btn.MouseEnter:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.12), {BackgroundTransparency = 0}):Play()
        TweenService:Create(stroke, TweenInfo.new(0.12), {Color = Color3.fromRGB(160, 160, 160)}):Play()
        TweenService:Create(icon, TweenInfo.new(0.12), {ImageColor3 = Color3.fromRGB(255, 255, 255)}):Play()
