    if method == "Normal" then
        normalFarmOn = true
        normalCoroutine = coroutine.wrap(normalFarm)()
    elseif method == "AFK Farming" then
        afkFarmOn = true
        afkCoroutine = coroutine.wrap(afkFarm)()
    elseif method == "AFK Farm Underneath" then
        if travelMethod ~= "Tween" then
            Window:Notify("AFK Farm Underneath", "This method currently only working for tween method nothing else", 5)
            return
        end
        afkUnderneathFarmOn = true
