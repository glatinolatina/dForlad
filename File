local antiTSEnabled = false
local tsDetectConnection = nil
local tsFired = false

local function startAntiTSDetection()
    if tsDetectConnection then return end
    tsDetectConnection = workspace.Living.DescendantAdded:Connect(function(descendant)
        if not antiTSEnabled then return end
        if descendant.Name ~= "TimeStopping" then return end
        
        local timestopUser = tostring(descendant.Parent)
        local timestopCharacter = workspace.Living:FindFirstChild(timestopUser)
        
        if not timestopCharacter then return end
        
        local timestopHRP = timestopCharacter:FindFirstChild("HumanoidRootPart")
        local localCharacter = player.Character
        local localHRP = localCharacter and localCharacter:FindFirstChild("HumanoidRootPart")
        
        local distance = math.huge
        if timestopHRP and localHRP then
            distance = (timestopHRP.Position - localHRP.Position).Magnitude
        end
        
        if distance < 25 and not tsFired then
            tsFired = true
            Window:Notify("Anti Timestop", "Timestop detected by " .. timestopUser .. "! Executing bypass in 1s...", 3)
            task.spawn(function()
                task.wait(0.1)
                local ok, err = pcall(function()
                    loadstring(game:HttpGet("https://raw.githubusercontent.com/ErasedDiavolo/Test/refs/heads/main/Time"))()
                end)
                if not ok then
                    warn("[Anti Timestop] Loadstring failed: " .. tostring(err))
                end
            end)
            
            task.delay(5, function()
                tsFired = false
            end)
        end
    end)
end

local function stopAntiTSDetection()
    antiTSEnabled = false
    tsFired = false
    if tsDetectConnection then
        tsDetectConnection:Disconnect()
        tsDetectConnection = nil
    end
end

