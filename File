local function startFarming(method)
    cancelTween()
    if method == "Normal" then
        normalFarmOn = true
        normalCoroutine = coroutine.wrap(normalFarm)()
    elseif method == "AFK Farming" then
        afkFarmOn = true
        afkCoroutine = coroutine.wrap(afkFarm)()
    elseif method == "AFK Farm Underneath" then
        if travelMethod ~= "Tween" then
            Window:Notify("AFK Farm Underneath", "This method currently only working for tween method nothing else", 5)
            return
        end
        afkUnderneathFarmOn = true
        afkUnderneathCoroutine = coroutine.wrap(afkUnderneathFarm)()
    elseif method == "Safe Place" then
        safePlaceFarmOn = true
        safePlaceCoroutine = coroutine.wrap(safePlaceFarm)()
    end
    enableNoclip()
end

local function stopFarming()
    normalFarmOn = false
    afkFarmOn = false
    afkUnderneathFarmOn = false
    safePlaceFarmOn = false
    stopRoam()
    cancelTween()
    disableNoclip()
end

