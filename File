            color = 3447003,
            timestamp = os.date("!%Y-%m-%dT%H:%M:%SZ"),
            footer = { text = "Webhook Messenger" }
        }}
    }

    local ok, err = _G.WebhookSendRequest(_G.WebhookMessengerURL, game:GetService("HttpService"):JSONEncode(payloadTable))

    if ok then
