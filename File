function getKillSkillRule(skillName)
    if not skillName or skillName == "" then return nil end
    local lower = skillName:lower()
    for _, p in ipairs(KILL_SKILL_PATTERNS) do
        if string.find(lower, p.match, 1, true) then
            return p
        end
    end
    return nil
end

