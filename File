    local bounds = {
        minX = -590, maxX = 590,
        minZ = -520, maxZ = 530,
        y = 100
    }
    local randomX = math.random(bounds.minX, bounds.maxX)
    local randomZ = math.random(bounds.minZ, bounds.maxZ)
    if not player.Character or not player.Character.HumanoidRootPart then return end
    local hrp = player.Character.HumanoidRootPart
    hrp.CFrame = CFrame.new(randomX, bounds.y, randomZ)
end

local function roamToRandom(shouldContinueFunc, customY)
    local bounds = {
        minX = -590, maxX = 590,
        minZ = -520, maxZ = 530,
        y = customY or 100
    }
    
    roaming = true
    roamCancelled = false
    
    while roaming and (not shouldContinueFunc or shouldContinueFunc()) do
        if roamCancelled then
            roaming = false
            return
        end
        
        local randomX = math.random(bounds.minX, bounds.maxX)
        local randomZ = math.random(bounds.minZ, bounds.maxZ)
        local randomPos = Vector3.new(randomX, bounds.y, randomZ)
        
        local function roamValidate()
            if roamCancelled then return false end
            if shouldContinueFunc then
                return shouldContinueFunc()
            end
            return true
        end
        
        travelToTween(randomPos, roamValidate)
    end
    
    roaming = false
end

local function stopRoam()
    roamCancelled = true
    roaming = false
    cancelTween()
end

