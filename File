function acquireHamon()
    if hasHamonReady() then return true end

    if PlayerPrestige.Value < 1 then return false end

    if PlayerMoney.Value < 10000 then
        setStatus("Need $10,000 for Hamon, continuing without it")
        return false
    end

    local hamonItem = hasAnyHamonItem()
    if not hamonItem then
        setStatus("No Hamon item in inventory, continuing without Hamon")
        return false
    end

    setStatus("Acquiring Hamon")
    
    pcall(function()
        local char = getCharacter()
        if char and hamonItem.Parent == player.Backpack then
            hamonItem.Parent = char
        end
    end)

    pcall(function()
        getRootPart().CFrame = CFrame.new(435, 9, -285)
        repeat
            task.wait(0.05)
            fireproximityprompt(Dialogues["Lisa Lisa"]:WaitForChild("ProximityPrompt"))
        until player.PlayerGui:FindFirstChild("DialogueGui") or not autoPrestigeEnabled
    end)
    if not autoPrestigeEnabled then return false end

    local lisaCFrame = CFrame.new(435, 9, -285)

    local function attemptLisaPurchase(seconds)
        local deadline = tick() + seconds
        repeat
            task.wait(0.25)
            pcall(function()
                local char = getCharacter()
                if char and not findHamonItemIn(char) then
                    local bp = findHamonItemIn(player.Backpack)
                    if bp then bp.Parent = char end
                end
                local hrp = getRootPart()
                local hrp = getRootPart()
                hrp.AssemblyLinearVelocity  = Vector3.zero
                hrp.AssemblyAngularVelocity = Vector3.zero
                hrp.CFrame = lisaCFrame
                local prompt = Dialogues["Lisa Lisa"]:WaitForChild("ProximityPrompt")
                for _ = 1, 3 do
                    fireproximityprompt(prompt)
                    task.wait()
                    pushLisaLisaDialogue()
                end
            end)
        until hasHamonReady() or tick() > deadline or not autoPrestigeEnabled
    end

    attemptLisaPurchase(12)
    if not autoPrestigeEnabled then return false end
    
    if not hasHamonReady() then
        pcall(function()
            getCharacter().Humanoid.Health = 0
        end)
        waitUntilNewChar()
        task.wait(6)
        if not autoPrestigeEnabled then return false end
        lisaCFrame = CFrame.new(435, 9, -285)
        attemptLisaPurchase(12)
    end

    if not hasHamonReady() then
        setStatus("Failed to acquire Hamon, continuing without it")
        return false
    end

    local char = getCharacter()
    local equipped = char and findHamonItemIn(char)
    if equipped then
        equipped.Parent = player.Backpack
    end
    
    for _, s in ipairs(SPEC_SKILLS) do
        learnSkill(s, "Spec")
    end
    
    task.wait()
    pcall(function() getCharacter().Humanoid.Health = 0.1 end)
    task.wait()
    pcall(function() getCharacter().Humanoid.Health = 0 end)
    waitUntilNewChar()

    task.wait(0.5)
    for _, s in ipairs(SPEC_SKILLS) do
        learnSkill(s, "Spec")
    end
    task.wait(1)
    
    setStatus("Hamon acquired!")
    return true
end

function firePrestige()
    setStatus("Firing prestige")
    local prevPrestige = PlayerPrestige.Value
    fireDialogue("Prestige", "Dialogue2", "Option1")
    task.wait(0.5)
    Window:Notify("Auto Prestige", "Prestiged to " .. (prevPrestige + 1) .. ".", 5)
    pcall(function() getCharacter().Humanoid.Health = 0.1 end)
    task.wait()
    pcall(function() getCharacter().Humanoid.Health = 0 end)
    waitUntilNewChar()
    task.wait(1)

