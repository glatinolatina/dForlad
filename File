function _G.NaJaToggleUI()
    if uiToggleDebounce then return end
    uiToggleDebounce = true
    task.delay(0.4, function() uiToggleDebounce = false end)

    local main = getMainFrame()
    if not main then return end

    if uiVisible then
        TweenService:Create(main, TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
            Size = UDim2.new(0, 0, 0, 0),
            BackgroundTransparency = 1
        }):Play()
        uiVisible = false
        task.wait(0.32)
        if main and main.Parent then
            main.Visible = false

        end
    else
        if main and main.Parent then
            main.Visible = true
            main.Size = UDim2.new(0, 0, 0, 0)
            main.BackgroundTransparency = 1
            local s = workspace.CurrentCamera.ViewportSize
            local vw, vh = s.X, s.Y
            local isMob = vw < 600 or vh < 500
            local scale = math.clamp(math.min((vw - 24) / 640, (vh - 24) / 450) * (isMob and 0.82 or 1), 0.45, 1)
            local w = math.clamp(math.floor(640 * scale + 0.5), 320, 800)
            local h = math.clamp(math.floor(450 * scale + 0.5), 240, 580)
            TweenService:Create(main, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
                Size = UDim2.new(0, w, 0, h),
                BackgroundTransparency = 0
            }):Play()
            uiVisible = true

        end
    end
end

