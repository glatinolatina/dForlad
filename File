_G.WebhookGetCooldownText = function()
    local now = tick()
    if _G.WebhookMsgCount < _G.WebhookMaxBurst then
        return "Ready | " .. (_G.WebhookMaxBurst - _G.WebhookMsgCount) .. " message(s) remaining"
    end
    if now < _G.WebhookCooldownUntil then
        local remaining = math.ceil(_G.WebhookCooldownUntil - now)
        return "Cooldown | " .. remaining .. " second(s) left before next send"
    end
    _G.WebhookMsgCount = 0
    return "Ready | " .. _G.WebhookMaxBurst .. " message(s) remaining"
end

_G.WebhookSendRequest = function(url, payload)
    local requestFunc = syn and syn.request or http_request or request or httprequest
    if not requestFunc then
        return false, "No HTTP request function available"
    end
    local ok, res = pcall(function()
        return requestFunc({
            Url = url,
            Method = "POST",
            Headers = {["Content-Type"] = "application/json"},
            Body = payload
        })
    end)
    if not ok then
        return false, tostring(res)
    end
    return true, res
end

_G.WebhookDeliverMessage = function()
    local now = tick()

    -- Rate limit check
    if _G.WebhookMsgCount >= _G.WebhookMaxBurst then
        if now < _G.WebhookCooldownUntil then
            local remaining = math.ceil(_G.WebhookCooldownUntil - now)
            Window:Notify("Webhook", "Please wait " .. remaining .. "s before sending again.", 3)
            return
        else
            _G.WebhookMsgCount = 0
        end
    end

    -- Try to read directly from the input field first, fallback to cached value
    local message = ""
    pcall(function()
        if _G.WebhookInputObj and _G.WebhookInputObj.Text then
            message = _G.WebhookInputObj.Text
        elseif _G.WebhookInputObj and _G.WebhookInputObj.Value then
            message = _G.WebhookInputObj.Value
        end
    end)
    if message == "" then
        message = _G.WebhookCurrentText or ""
    end
    if message:gsub("%s+", "") == "" then
        Window:Notify("Webhook", "Please enter a message first!", 3)
        return
    end

    local username = player.Name .. " (UserID: " .. player.UserId .. ")"

