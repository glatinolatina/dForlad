        if c.Name == npcName
            and c:FindFirstChild("HumanoidRootPart")
            and c:FindFirstChild("Health")
            and c.Health.Value > 0 then
            return c
        end
    end
    return nil
end

function prestigeKillNPC(npcName, offsetZ, offsetY)
    local npc = workspace.Living:FindFirstChild(npcName)
    if not npc or not npc:FindFirstChild("HumanoidRootPart") then return end
    local npcHRP = npc.HumanoidRootPart
    local maxHP  = (npc:FindFirstChild("Health") and npc.Health.Value) or 100

    local function stabilizeRoot(anchoredState)
        local hrp = getRootPart()
        if not hrp then return end
        hrp.AssemblyLinearVelocity  = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
        if anchoredState ~= nil then
            hrp.Anchored = anchoredState
        end
    end

    local function ensureStandSummoned(timeoutSec)
        local deadline = tick() + (timeoutSec or 1.8)
        while autoPrestigeEnabled and tick() < deadline do
            local stand = getStandMorph()
            if stand and stand.Parent then
                return stand
            end
            toggleStand()
            task.wait(0.25)
        end
        return getStandMorph()
    end

    task.spawn(learnAllSkills)

    local engagePos = npcHRP.CFrame - npcHRP.CFrame.LookVector * (offsetZ or 2)
        - Vector3.new(0, offsetY or 20, 0)
    stabilizeRoot(false)
    getRootPart().CFrame = CFrame.lookAt(engagePos.Position, npcHRP.Position)
    stabilizeRoot(false)
    task.wait(PRESTIGE_ENTRY_TELEPORT_WAIT)

    local char = getCharacter()
    local FocusCam
    if char then
        if char:FindFirstChild("FocusCam") == nil then
            FocusCam = Instance.new("ObjectValue", char)
            FocusCam.Name = "FocusCam"
            FocusCam.Value = npcHRP
        else
            FocusCam = char:FindFirstChild("FocusCam")
            if FocusCam then FocusCam.Value = npcHRP end
        end
    end

    local killConfirmed = false
    local xpConn = player.PlayerStats.Experience:GetPropertyChangedSignal("Value"):Connect(function()
        killConfirmed = true
    end)

    local moneyConn
    pcall(function()
        moneyConn = player.PlayerGui:WaitForChild("HUD").Main.DropMoney.Money.ChildAdded:Connect(function()
            killConfirmed = true
        end)
    end)

    local function settle()
        local hrp = getRootPart()
        if not hrp then return end
        hrp.AssemblyLinearVelocity  = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
        hrp.Anchored = true
        local frames = (npcName == "Vampire")
            and math.max(18, math.floor(PRESTIGE_POST_KILL_SETTLE_MAX_FRAMES * 0.65))
            or PRESTIGE_POST_KILL_SETTLE_MAX_FRAMES
        while autoPrestigeEnabled and frames > 0 and not killConfirmed do
            task.wait()
            frames = frames - 1
        end
        local hrp2 = getRootPart()
        if hrp2 then
            hrp2.AssemblyLinearVelocity  = Vector3.zero
            hrp2.AssemblyAngularVelocity = Vector3.zero
            hrp2.Anchored = false
        end
    end

    while autoPrestigeEnabled do
        task.wait()
        
        local char = player.Character
        local humanoid = char and char:FindFirstChildWhichIsA("Humanoid")
        if not char or not humanoid or humanoid.Health <= 0 then
            pcall(function() if FocusCam then FocusCam:Destroy() end end)
            if xpConn then xpConn:Disconnect() end
            if moneyConn then moneyConn:Disconnect() end
            stabilizeRoot(false)
            return
        end
        
        stabilizeRoot(false)

        if FocusCam and FocusCam.Parent then FocusCam.Value = npcHRP end
        local stillAlive = npc and npc.Parent
            and npc:FindFirstChild("Health")
            and npc.Health.Value > 0
        if npcName == "Security Guard" and not stillAlive and not killConfirmed then
            local nextTarget = findAliveNpcByName(npcName)
            if nextTarget and nextTarget ~= npc then
                npc    = nextTarget
                npcHRP = nextTarget.HumanoidRootPart
                maxHP  = (nextTarget:FindFirstChild("Health") and nextTarget.Health.Value) or maxHP
                task.wait()
                continue
            end
        end
        if not stillAlive or killConfirmed then
            pcall(function()
                getRemoteEvent():FireServer("InputEnded", { Input = Enum.KeyCode.E })
            end)
            settle()
            break
        end

        if not getStandMorph() then
            if not ensureStandSummoned(2) then
                stabilizeRoot(false)
                task.wait(0.1)
                continue
            end
        end

        pcall(function()
            local char   = player.Character
            local remote = getRemoteEvent()
            if not char or not remote then return end

            if game:GetService("CollectionService"):HasTag(npc, "Blocking") then
                remote:FireServer("InputBegan", { Input = Enum.KeyCode.R })
            end

            local hpFrac    = (npc:FindFirstChild("Health") and npc.Health.Value or 0) / maxHP
            local ragdolled = npc:FindFirstChild("RagdollParts") ~= nil
            local barraging = char:FindFirstChild("Stand Barraging") ~= nil

            local stand = getStandMorph()
            local standRoot = stand and stand:FindFirstChild("HumanoidRootPart")
            if standRoot and npc:FindFirstChild("Head") then
                standRoot.CFrame = CFrame.lookAt(
                    npc.Head.Position - Vector3.new(0, 3.8, 0),
                    npcHRP.Position
                )
            end

            if isSkillOnCooldown("Stand Barrage") or ragdolled or hpFrac <= 0.45 then
                remote:FireServer("InputEnded", { Input = Enum.KeyCode.E })
            else
                remote:FireServer("InputBegan", { Input = Enum.KeyCode.E })
            end

            if not ragdolled and not barraging then
                local function tryKey(keyName)
                    local skill = getSkillOnKey(char, keyName)
                    if not skill or skill == "" then return false end
                    if skill == "Ora Kicks" then return false end
                    if not hasStandSkill(skill) then return false end
                    if isSkillOnCooldown(skill) then return false end
                    local activeStand = PlayerStand.Value
                    if activeStand == "Silver Chariot" then
                        local lower = skill:lower()
                        if string.find(lower, "barrage", 1, true) then return false end
                    else
                        local rule = getKillSkillRule(skill)
                        if not rule then return false end
                        if rule.hpGate and hpFrac <= rule.hpGate then return false end
                    end
                    local kc = Enum.KeyCode[keyName]
                    if not kc then return false end
                    remote:FireServer("InputBegan", { Input = kc })
                    remote:FireServer("InputEnded", { Input = kc })
                end
                local activeStand = PlayerStand.Value
                local keyPlan = PRESTIGE_STAND_KEYS[activeStand] or DEFAULT_KEY_PLAN
                for _, keyName in ipairs(keyPlan) do
                    tryKey(keyName)
                end
            end

            remote:FireServer("Attack", "m1")
            local followPos = npcHRP.CFrame - npcHRP.CFrame.LookVector * (offsetZ or 2)
                - Vector3.new(0, offsetY or 20, 0)
            getRootPart().CFrame = CFrame.lookAt(followPos.Position, npcHRP.Position)
            stabilizeRoot(false)
        end)

    end

    if xpConn then xpConn:Disconnect() end
    if moneyConn then moneyConn:Disconnect() end
    pcall(function() if FocusCam then FocusCam:Destroy() end end)
    stabilizeRoot(false)
end

