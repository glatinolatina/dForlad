_G._startFpsMonitor = function()
    if _G._fpsConn then return end
    _G._fpsFrameTimes = {}
    _G._lastStableFps = 60
    _G._fpsConn = RunService.Heartbeat:Connect(function(dt)
        table.insert(_G._fpsFrameTimes, dt)
        if #_G._fpsFrameTimes > 60 then
            table.remove(_G._fpsFrameTimes, 1)
        end
    end)
end

_G._stopFpsMonitor = function()
    if _G._fpsConn then
        _G._fpsConn:Disconnect()
        _G._fpsConn = nil
    end
    _G._fpsFrameTimes = {}
end

_G._isFpsStable = function()
    if not _G.AntiKickSafePlaceEnabled then return true end
    if #_G._fpsFrameTimes < 10 then return false end
    _G._avgDt = 0
    _G._spikes = 0
    for _, t in ipairs(_G._fpsFrameTimes) do
        _G._avgDt = _G._avgDt + t
        if t > 0.1 then _G._spikes = _G._spikes + 1 end
    end
    _G._avgDt = _G._avgDt / #_G._fpsFrameTimes
    _G._lastStableFps = math.floor(1 / _G._avgDt)
    if _G._avgDt > 0.08 then return false end
    if _G._spikes > 2 then return false end
    return true
end

