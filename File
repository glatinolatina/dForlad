local KILL_SKILL_PATTERNS = {
    { match = "finger", hpGate = 0.4 },
    { match = "kick",   hpGate = 0.4 },
    { match = "rage",   hpGate = nil  },
}
local PRESTIGE_ENTRY_TELEPORT_WAIT = 0.15
