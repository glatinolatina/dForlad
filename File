local function aggressiveStorylineAdvance(timeoutSec)
    timeoutSec = timeoutSec or 15
    local deadline = tick() + timeoutSec
    
    while autoPrestigeEnabled and tick() < deadline do
        local char = player.Character
        local humanoid = char and char:FindFirstChildWhichIsA("Humanoid")
        if not char or not humanoid or humanoid.Health <= 0 then
            return false
        end
        
        local quests = getQuests()
        if next(quests) ~= nil then
            return true
        end
                
        local remoteEvent = getRemoteEvent()
        for i = 1, 18 do
            if not autoPrestigeEnabled then return false end
            local key = STORYLINE_KEYS[i]
            pcall(function()
                remoteEvent:FireServer("DialogueInteracted", {
                    ["DialogueName"] = "Storyline " .. key,
                    ["Speaker"] = "Storyline " .. key
                })
            end)
            task.wait(0.05)
            fireDialogue("Storyline " .. key, STORYLINE_DLG[i], "Option1")
            task.wait(0.08)
        end
        
        for i = 1, 14 do
            if not autoPrestigeEnabled then return false end
            pcall(function()
                remoteEvent:FireServer("DialogueInteracted", {
                    ["DialogueName"] = "Storyline #" .. i,
                    ["Speaker"] = "Storyline #" .. i
                })
            end)
            task.wait(0.05)
            fireDialogue("Storyline #" .. i, "Dialogue2", "Option1")
            task.wait(0.05)
        end
        
        task.wait(0.5)
    end
    
    return next(getQuests()) ~= nil
end

