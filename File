    repeat
        task.wait(0.3)
        aggressiveStorylineAdvance(3)
    until next(getQuests()) ~= nil or tick() > deadline or not autoPrestigeEnabled
end

function progressStory()
    local quests = getQuests()

    for _, e in ipairs(STORY_NPCS) do
        if not autoPrestigeEnabled then return false end
        if quests[e.quest] then
            setStatus("Killing " .. e.npc)
            while autoPrestigeEnabled and getQuests()[e.quest] do
                local char = player.Character
                local humanoid = char and char:FindFirstChildWhichIsA("Humanoid")
                if not char or not humanoid or humanoid.Health <= 0 then
                    task.wait(0.5)
                    break
                end
                prestigeKillNPC(e.npc, e.offZ, e.offY)
                if e.npc == "Security Guard" then
                    task.wait(0.8)
                else
                    task.wait(PRESTIGE_CHAIN_WAIT)
                end
            end
            if e.npc == "Diavolo" then
                setStatus("Finishing Storyline")
                fireDialogue("Storyline #14", "Dialogue7", "Option1")
                task.wait(3)
                pcall(function() getCharacter().Humanoid.Health = 0.1 end)
                task.wait()
                pcall(function() getCharacter().Humanoid.Health = 0 end)
                waitUntilNewChar()
                task.wait(1)
            end
            return true
        end
    end

    local hasVampireQuest = quests[VAMPIRE_QUEST] ~= nil
    if hasVampireQuest then
        if shouldTryHamonNow() and not hasHamonReady() then
            local gotHamon = acquireHamon()
            if not autoPrestigeEnabled then return false end
        end

        if not getQuests()[VAMPIRE_QUEST] then
            setStatus("Asking William Zeppeli")
            for _ = 1, 10 do
                if not autoPrestigeEnabled then return false end
                fireDialogue("William Zeppeli", "Dialogue4", "Option1")
                task.wait(0.5)
                if getQuests()[VAMPIRE_QUEST] then break end
            end
        end

        if getQuests()[VAMPIRE_QUEST] then
            setStatus("Killing Vampires")
            while autoPrestigeEnabled and getQuests()[VAMPIRE_QUEST] do
                local char = player.Character
                local humanoid = char and char:FindFirstChildWhichIsA("Humanoid")
                if not char or not humanoid or humanoid.Health <= 0 then
                    task.wait(0.5)
                    break
                end
                prestigeKillNPC("Vampire", VAMPIRE_OFFZ, VAMPIRE_OFFY)
                task.wait(PRESTIGE_VAMPIRE_CHAIN_WAIT)
            end
            return true
        else
            setStatus("Storyline complete. Retrying vampire quest...")
            task.wait(1.5)
            return true
        end
    end

    return false
end

function runAutoPrestige()
    if autoPrestigeBusy then return end
    autoPrestigeBusy = true

    local equippedStand = PlayerStand.Value
    if BLACKLISTED_STANDS[equippedStand] then
        Window:Notify("Auto Prestige", "Your stand is not supported for Auto Storyline.", 7)
        autoPrestigeEnabled = false
        autoPrestigeBusy = false
        setStatus("Blacklisted stand")
        return
    end
    task.spawn(learnAllSkills)

    while autoPrestigeEnabled do
        local char = player.Character
        local humanoid = char and char:FindFirstChildWhichIsA("Humanoid")
        if not char or not humanoid or humanoid.Health <= 0 then
            setStatus("Waiting for respawn...")
            desummonStand()
            repeat
                task.wait(0.5)
                char = player.Character
                humanoid = char and char:FindFirstChildWhichIsA("Humanoid")
