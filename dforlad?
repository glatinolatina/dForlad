	local QuestDialogueBridge = config and config.dialogue or {}

	local function normalizeDialogueText(value)
		local text = string.lower(tostring(value or ""))
		text = text:gsub("[^%w%s]", " ")
		text = text:gsub("%s+", " ")
		return text:match("^%s*(.-)%s*$") or ""
	end

	local function containsDialoguePhrase(text, phrase)
		local haystack = " " .. normalizeDialogueText(text) .. " "
		local needle = " " .. normalizeDialogueText(phrase) .. " "
		return needle ~= "  " and haystack:find(needle, 1, true) ~= nil
	end

	local function questOptionText(button)
		if not button then return "" end
		local pieces = {}
		if button:IsA("TextButton") and button.Text ~= "" then table.insert(pieces, button.Text) end
		for _, child in ipairs(button:GetDescendants()) do
			if (child:IsA("TextLabel") or child:IsA("TextButton") or child:IsA("TextBox")) and child.Text and child.Text ~= "" then
				table.insert(pieces, child.Text)
			end
		end
		return normalizeDialogueText(table.concat(pieces, " "))
	end

	local function questDialogueMatchesNPC(gui, npc, dialogueName)
		if not gui or not npc then return false end
		local pieces = {}
		for _, child in ipairs(gui:GetDescendants()) do
			if child:IsA("TextLabel") or child:IsA("TextButton") or child:IsA("TextBox") then
				if child.Text and child.Text ~= "" then table.insert(pieces, child.Text) end
			end
		end
		local joined = normalizeDialogueText(table.concat(pieces, " "))
		local npcName = normalizeDialogueText(npc.Name)
		npcName = npcName:gsub(" lvl %d+.*$", "")
		local dialog = normalizeDialogueText(dialogueName)
		return (npcName ~= "" and containsDialoguePhrase(joined, npcName))
			or (dialog ~= "" and #dialog >= 4 and containsDialoguePhrase(joined, dialog))
	end

	local function chooseQuestOption(gui, mode)
		local positive = mode == "turnin"
			and {"turn in", "complete", "finished", "reward", "claim", "deliver", "hand over", "here", "done", "yes", "continue", "next", "okay", "ok"}
			or {"accept", "take quest", "help", "start", "begin", "yes", "quest", "sure", "okay", "ok", "ready", "do it"}

		local negative = {"no thanks", "not now", "don't", "do not", "decline", "cancel", "leave", "later", "never mind", "no, "}
		local firstName, firstButton, firstScore = nil, nil, -math.huge

		for optionIndex = 1, 8 do
			local optionName = "Option" .. tostring(optionIndex)
			local button = QuestDialogueBridge.option and QuestDialogueBridge.option(gui, optionName)
			if button and button.Parent and QuestDialogueBridge.isVisible and QuestDialogueBridge.isVisible(button) then
				if not firstButton then
					firstName, firstButton = optionName, button
				end

				local text = questOptionText(button)
				local score = 0
				for _, word in ipairs(positive) do
					if containsDialoguePhrase(text, word) then score = score + 2 end
				end
				for _, word in ipairs(negative) do
					if containsDialoguePhrase(text, word) then score = score - 5 end
				end
				if score > firstScore then
					firstName, firstButton, firstScore = optionName, button, score
				end
			end
		end

		return firstName, firstButton
	end

	local function driveQuestDialogue(NPC, mode, forceAccept)
		if State.Selling or not NPC then return false end

		-- Normal acceptance resumes an existing quest. A manual override is the
		-- exception: deliberately open the selected giver so the server can switch
		-- the quest if the game permits it.
		if mode == "accept" and not forceAccept then
			local stats = player and player:FindFirstChild("PlayerStats")
			local currentQuestObject = stats and stats:FindFirstChild("CurrentQuest")
			local progressObject = stats and stats:FindFirstChild("QuestProgress")
			local maxObject = stats and stats:FindFirstChild("QuestMaxProgress")
			local activeQuestName = currentQuestObject and tostring(currentQuestObject.Value or "") or ""
			if activeQuestName ~= "" then
				local progress = tonumber(progressObject and progressObject.Value) or 0
				local maximum = tonumber(maxObject and maxObject.Value) or 0
				if maximum > 0 and progress >= maximum then
					getgenv().CompletedQuest = true
					FarmState.CompletedQuest = true
					return false
				end
				getgenv().CompletedQuest = false
				FarmState.CompletedQuest = false
				FarmState.CurrentQuest = activeQuestName
				QuestRuntime.ActiveQuest = activeQuestName
				-- Do not copy the server's current quest into SelectedQuest. That variable is
				-- the user's manual target and must survive resume/turn-in operations.
				return true
			end
		end

		local dialogueNameObject = NPC:FindFirstChild("Dialogue")
		local dialogueName = dialogueNameObject and tostring(dialogueNameObject.Value or "") or ""
		if dialogueName == "" then return false end

		local character = GetCharacter()
		local remote = character and character:FindFirstChild("RemoteEvent")
		if not remote then return false end

		local dialogueFolder = ReplicatedStorage:FindFirstChild("Dialogue")
		local templateName = NPC.Name == "DIO [Lvl. 35+]" and "DIO" or dialogueName
		local dialogueTemplate = dialogueFolder and dialogueFolder:FindFirstChild(templateName)
		local gui = QuestDialogueBridge.currentDialogue and QuestDialogueBridge.currentDialogue()
		local opened = false

		local function dismissPreviousDialogueOnce()
			if QuestDialogueBridge.skipClick then pcall(QuestDialogueBridge.skipClick) end
			task.wait(0.12)
			return not (QuestDialogueBridge.currentDialogue and QuestDialogueBridge.currentDialogue())
		end

		if gui then
			-- Never click through a dialogue left open by a different quest giver. This
			-- was allowing a Dracula turn-in screen to accept Dracula again instead of
			-- the manually selected or level-best quest. Try the dialogue's skip/close
			-- control once, then refuse to interact if it is still showing.
			local trackedTarget = QuestRuntime.DialogueTarget
			if trackedTarget and trackedTarget ~= NPC.Name then
				if dismissPreviousDialogueOnce() then
					QuestRuntime.DialogueTarget = nil
					gui = nil
				else
					setQuestStatus("Waiting for previous dialogue", "The " .. tostring(trackedTarget) .. " dialogue is still open. It will not be used to accept " .. tostring(NPC.Name) .. ".")
					return false
				end
			elseif trackedTarget == NPC.Name or questDialogueMatchesNPC(gui, NPC, dialogueName) then
				QuestRuntime.DialogueTarget = NPC.Name
				opened = true
			else
				if dismissPreviousDialogueOnce() then
					QuestRuntime.DialogueTarget = nil
					gui = nil
				else
					setQuestStatus("Waiting for previous dialogue", "A different or unidentified NPC dialogue is open. It will not be reused for " .. tostring(NPC.Name) .. ".")
					return false
				end
			end
		else
			QuestRuntime.DialogueTarget = nil
		end

		if State.Selling then return false end

		if not opened and dialogueTemplate then
			if State.Selling then return false end
			QuestRuntime.DialogueTarget = NPC.Name
			pcall(function()
				remote:FireServer("PromptTriggered", dialogueTemplate)
			end)
			if QuestDialogueBridge.waitDialogue then
				gui = QuestDialogueBridge.waitDialogue(3)
				opened = gui ~= nil
			end
			if not opened then QuestRuntime.DialogueTarget = nil end
		end

		if not opened then
			if State.Selling then return false end
			QuestRuntime.DialogueTarget = NPC.Name
			pcall(function()
				remote:FireServer("DialogueInteracted", {
					DialogueName = dialogueName,
					Speaker = NPC.Name,
				})
			end)
			if QuestDialogueBridge.waitDialogue then
				gui = QuestDialogueBridge.waitDialogue(4)
				opened = gui ~= nil
			end
			if not opened then QuestRuntime.DialogueTarget = nil end
		end

		if not opened then
			return false
		end

		local deadline = tick() + 12
		local actionCount = 0
		local clickedAny = false
		local sawGui = false
		local turnInInitialRaw = tostring((player:FindFirstChild("PlayerStats") and player.PlayerStats:FindFirstChild("CurrentQuest") and player.PlayerStats.CurrentQuest.Value) or "")
		local turnInInitialProgress = tonumber((player:FindFirstChild("PlayerStats") and player.PlayerStats:FindFirstChild("QuestProgress") and player.PlayerStats.QuestProgress.Value) or 0) or 0
		local turnInInitialMaximum = tonumber((player:FindFirstChild("PlayerStats") and player.PlayerStats:FindFirstChild("QuestMaxProgress") and player.PlayerStats.QuestMaxProgress.Value) or 0) or 0

		local function turnInStateAdvanced()
			if mode ~= "turnin" then return false end
			local stats = player and player:FindFirstChild("PlayerStats")
			local current = stats and stats:FindFirstChild("CurrentQuest")
			local progressObject = stats and stats:FindFirstChild("QuestProgress")
			local maximumObject = stats and stats:FindFirstChild("QuestMaxProgress")
			local rawNow = current and tostring(current.Value or "") or ""
			local progressNow = tonumber(progressObject and progressObject.Value) or 0
			local maximumNow = tonumber(maximumObject and maximumObject.Value) or 0
			if turnInInitialRaw ~= "" and (rawNow == "" or rawNow ~= turnInInitialRaw) then return true end
			if turnInInitialMaximum > 0 and turnInInitialProgress >= turnInInitialMaximum then
				if maximumNow < turnInInitialMaximum or (maximumNow > 0 and progressNow < maximumNow) then return true end
			end
			return false
		end

		while tick() < deadline and actionCount < 32 and FarmState.Active do
			if State.Selling then return false end
			if turnInStateAdvanced() then
				if QuestDialogueBridge.currentDialogue and QuestDialogueBridge.currentDialogue() and QuestDialogueBridge.skipClick then
					pcall(QuestDialogueBridge.skipClick)
					task.wait(0.12)
				end
				if not (QuestDialogueBridge.currentDialogue and QuestDialogueBridge.currentDialogue()) and QuestRuntime.DialogueTarget == NPC.Name then
					QuestRuntime.DialogueTarget = nil
				end
				return clickedAny
			end
			gui = QuestDialogueBridge.currentDialogue and QuestDialogueBridge.currentDialogue()
			if gui then
				sawGui = true
				local optionName, target = chooseQuestOption(gui, mode)

				if target and optionName then
					local clicked = false
					if QuestDialogueBridge.click then
						clicked = QuestDialogueBridge.click(target) == true
					end
					if not clicked and QuestDialogueBridge.waitAndClickOption then
						clicked = QuestDialogueBridge.waitAndClickOption(optionName, 0.8) == true
					end

					if clicked then
						clickedAny = true
						actionCount = actionCount + 1
						task.wait(0.16)
						if turnInStateAdvanced() then
							-- A claimed quest may leave a follow-up option visible. Close/skip that
							-- dialogue without selecting another option, then stop immediately.
							if QuestDialogueBridge.currentDialogue and QuestDialogueBridge.currentDialogue() and QuestDialogueBridge.skipClick then
								pcall(QuestDialogueBridge.skipClick)
								task.wait(0.12)
							end
							if not (QuestDialogueBridge.currentDialogue and QuestDialogueBridge.currentDialogue()) and QuestRuntime.DialogueTarget == NPC.Name then
								QuestRuntime.DialogueTarget = nil
							end
							return clickedAny
						end
					else
						task.wait(0.08)
					end
				else
					if QuestDialogueBridge.skipClick then
						QuestDialogueBridge.skipClick()
					elseif QuestDialogueBridge.waitAndClickOption then
						QuestDialogueBridge.waitAndClickOption("Option1", 0.5)
					end
					actionCount = actionCount + 1
					task.wait(0.16)
				end
			elseif sawGui then
				task.wait(0.25)
				gui = QuestDialogueBridge.currentDialogue and QuestDialogueBridge.currentDialogue()
				if not gui then
					if QuestRuntime.DialogueTarget == NPC.Name then QuestRuntime.DialogueTarget = nil end
					return clickedAny
				end
			else
				task.wait(0.1)
			end
		end

		if not (QuestDialogueBridge.currentDialogue and QuestDialogueBridge.currentDialogue()) and QuestRuntime.DialogueTarget == NPC.Name then
			QuestRuntime.DialogueTarget = nil
		end
		return clickedAny
	end

	local function GetQuest(NPC, forceAccept)
		if not NPC then return false end
		local ok = driveQuestDialogue(NPC, "accept", forceAccept == true)
		if ok then
			getgenv().CompletedQuest = false
			FarmState.CompletedQuest = false
		end
		return ok
	end

	local function TurnInQuest(NPC)
		if not NPC then return false end
		return driveQuestDialogue(NPC, "turnin")
	end

