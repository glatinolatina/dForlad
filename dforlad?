local function buildPlayerList()
    local list = {"--"}
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LP then table.insert(list, plr.Name) end
    end
    table.sort(list, function(a, b)
        if a == "--" then return true end
