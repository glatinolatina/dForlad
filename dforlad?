local kidnapShuffle = false
local kidnapEnabled = false
local kidnapLoopToken = 0
local kidnapToggle = nil
local kidnapCleanup = nil
local kidnapDropdown = nil
local kidnapCollisionCache = {}

local function restoreKidnapCollision()
    for part, canCollide in pairs(kidnapCollisionCache) do
        if part and part.Parent then
            pcall(function() part.CanCollide = canCollide end)
        end
        kidnapCollisionCache[part] = nil
    end
end

local function applyKidnapNoclip(character)
    for _, part in ipairs(character:GetDescendants()) do
        if part:IsA("BasePart") then
            if kidnapCollisionCache[part] == nil then kidnapCollisionCache[part] = part.CanCollide end
            part.CanCollide = false
        end
    end
end

local function kidnapTeleportUp(root)
    if not root or not root.Parent then return end
    local fallenY = workspace.FallenPartsDestroyHeight
    local position = root.Position
    if position.Y < fallenY + 100 then
        root.Position = Vector3.new(position.X, fallenY + 180, position.Z)
    end
    root.Anchored = true
    root.AssemblyLinearVelocity = Vector3.zero
    root.AssemblyAngularVelocity = Vector3.zero
    local pad = Instance.new("Part")
    pad.Name = "MethionKidnapRecoveryPad"
    pad.Anchored = true
    pad.CanCollide = true
    pad.Size = Vector3.new(150, 1, 150)
    pad.Transparency = 1
    pad.CFrame = root.CFrame * CFrame.new(0, 200, 0)
    pad.Parent = workspace
    root.CFrame = pad.CFrame * CFrame.new(0, 6, 0)
    root.Anchored = false
    task.delay(15, function()
        if pad and pad.Parent then pcall(function() pad:Destroy() end) end
    end)
end

local function kidnapCooldownActive()
    local playerGui = LP:FindFirstChildOfClass("PlayerGui") or LP:FindFirstChild("PlayerGui")
    local hud = playerGui and playerGui:FindFirstChild("HUD")
    local cooldowns = hud and hud:FindFirstChild("Cooldowns")
    if not cooldowns then return false end
    local frame = cooldowns:FindFirstChild("Kidnap") or cooldowns:FindFirstChild("KIDNAP")
    return frame ~= nil and frame:IsA("Frame") and frame.Visible == true
end

local function getKidnapTarget()
    if kidnapManualName ~= "" then
        local query = string.lower(kidnapManualName)
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LP and string.sub(string.lower(player.Name), 1, #query) == query then
                return player
            end
        end
        return nil
    end
    if kidnapShuffle then
        local candidates = {}
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LP then table.insert(candidates, player) end
        end
        return #candidates > 0 and candidates[math.random(1, #candidates)] or nil
    end
    return kidnapTargetName ~= "--" and Players:FindFirstChild(kidnapTargetName) or nil
end

local function performKidnap(target, token)
    if not target or target == LP or not target.Character then return end
    local character = LP.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    local remote = character and character:FindFirstChild("RemoteEvent")
    if not root or not remote then return end

    if not getStandMorph() then
        local remoteFunction = character:FindFirstChild("RemoteFunction")
        if remoteFunction then
            pcall(function() remoteFunction:InvokeServer("ToggleStand", "Toggle") end)
            local deadline = os.clock() + 2
            while os.clock() < deadline and kidnapEnabled and kidnapLoopToken == token and not getStandMorph() do
                task.wait(0.1)
            end
        end
        if not getStandMorph() then
            notifyTroll("Mr. President", "The stand could not be summoned.", "Warning")
            return
        end
    end
    if not kidnapEnabled or kidnapLoopToken ~= token or kidnapCooldownActive() then return end

    local targetRoot = target.Character and target.Character:FindFirstChild("HumanoidRootPart")
    if not targetRoot then return end
    local originalAnchored = root.Anchored
    local raisedAfterKidnap = false
    local cleaned = false
    local function cleanup()
        if cleaned then return end
        cleaned = true
        if raisedAfterKidnap and root and root.Parent then
            pcall(kidnapTeleportUp, root)
        elseif root and root.Parent then
            pcall(function() root.Anchored = originalAnchored end)
        end
        restoreKidnapCollision()
        if kidnapCleanup then kidnapCleanup = nil end
    end
    kidnapCleanup = cleanup

    local ok, err = pcall(function()
        local pos = (targetRoot.CFrame * CFrame.new(0, 0, -1)).Position
        root.CFrame = CFrame.lookAt(pos, targetRoot.Position)
        task.wait(0.05)
        if not kidnapEnabled or kidnapLoopToken ~= token then return end

        root.Anchored = true
        remote:FireServer("InputBegan", {Input = Enum.KeyCode.E})
        local start = os.clock()
        while os.clock() - start < 0.8 do
            if not kidnapEnabled or kidnapLoopToken ~= token then break end
            if targetRoot and targetRoot.Parent then
                pcall(function()
                    local followPos = (targetRoot.CFrame * CFrame.new(0, 0, -1)).Position
                    root.CFrame = CFrame.lookAt(followPos, targetRoot.Position)
                end)
            end
            task.wait()
        end
        pcall(function() remote:FireServer("InputEnded", {Input = Enum.KeyCode.E}) end)
        if not kidnapEnabled or kidnapLoopToken ~= token then return end
        task.wait(0.2)
        applyKidnapNoclip(character)
        root.CFrame = CFrame.new(-480.5379943847656, -135.09373474121094, -2050.510986328125)
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
        raisedAfterKidnap = true
        remote:FireServer("InputBegan", {Input = Enum.KeyCode.Z})
        task.wait(0.1)
        pcall(function() remote:FireServer("InputEnded", {Input = Enum.KeyCode.Z}) end)
        task.wait(1.5)
    end)
    cleanup()
    if not ok then notifyTroll("Mr. President", "Kidnap action failed: " .. tostring(err), "Warning") end
end

