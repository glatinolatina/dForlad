end

function Weather.setDensity(value)
    local atm = Lighting:FindFirstChildOfClass("Atmosphere")
    if not atm then
        atm = Instance.new("Atmosphere")
        atm.Name = "Atmosphere"
        atm.Parent = Lighting
    end
    atm.Density = math.clamp(tonumber(value) or atm.Density, 0, 1)
    Weather.ActivePreset = "Custom"
    Weather.updateStatus()
end

function Weather.setSunRays(enabled)
    Weather.sunRays(enabled == true)
    Weather.ActivePreset = "Custom"
    Weather.updateStatus()
end

function Weather.reset()
    local atm = Lighting:FindFirstChildOfClass("Atmosphere")
    if weatherOrig.AtmosphereInstance then
        if not atm then
            atm = Instance.new("Atmosphere")
            atm.Name = "Atmosphere"
            atm.Parent = Lighting
        end
        atm.Density = weatherOrig.AtmosphereDensity
        atm.Haze = weatherOrig.AtmosphereHaze
        atm.Color = weatherOrig.AtmosphereColor
        atm.Decay = weatherOrig.AtmosphereDecay
        atm.Glare = weatherOrig.AtmosphereGlare
        atm.Offset = weatherOrig.AtmosphereOffset
    elseif atm then
        atm:Destroy()
    end

    Lighting.ClockTime = weatherOrig.ClockTime
    Lighting.Brightness = weatherOrig.Brightness
    Lighting.Ambient = weatherOrig.Ambient
    Lighting.OutdoorAmbient = weatherOrig.OutdoorAmbient
    Lighting.FogColor = weatherOrig.FogColor
    Lighting.FogStart = weatherOrig.FogStart
    Lighting.FogEnd = weatherOrig.FogEnd

    local sr = Lighting:FindFirstChild("SunRaysEffect")
    if weatherOrig.SunRaysInstance then
        if not sr then
            sr = Instance.new("SunRaysEffect")
            sr.Name = "SunRaysEffect"
            sr.Parent = Lighting
        end
        sr.Enabled = weatherOrig.SunRaysEnabled
        sr.Intensity = weatherOrig.SunRaysIntensity
        sr.Spread = weatherOrig.SunRaysSpread
    elseif sr then
        sr:Destroy()
    end

    Weather.ActivePreset = "Original"
    Weather.updateStatus()
end

function Weather.apply(preset)
    local atm = Lighting:FindFirstChildOfClass("Atmosphere")
    if not atm then
        atm = Instance.new("Atmosphere")
        atm.Name = "Atmosphere"
        atm.Parent = Lighting
    end

    Lighting.Brightness = weatherOrig.Brightness
    Lighting.Ambient = weatherOrig.Ambient
    Lighting.OutdoorAmbient = weatherOrig.OutdoorAmbient
    Lighting.FogColor = weatherOrig.FogColor
    Lighting.FogStart = weatherOrig.FogStart
    Lighting.FogEnd = weatherOrig.FogEnd
    atm.Density = weatherOrig.AtmosphereDensity
    atm.Haze = weatherOrig.AtmosphereHaze
    atm.Color = weatherOrig.AtmosphereColor
    atm.Decay = weatherOrig.AtmosphereDecay
    atm.Glare = weatherOrig.AtmosphereGlare
    atm.Offset = weatherOrig.AtmosphereOffset
    Weather.sunRays(false)

    local presetTime = nil
    if preset == "Clear" then
        presetTime = 12
        Lighting.Brightness = 3
        atm.Density = 0.08
        atm.Haze = 0
        atm.Color = Color3.fromRGB(255, 240, 200)
    elseif preset == "Sunny" then
        presetTime = 14
        Lighting.Brightness = 2.5
        atm.Density = 0.12
        atm.Haze = 0
        atm.Color = Color3.fromRGB(255, 246, 225)
        Weather.sunRays(true)
    elseif preset == "Sunset" then
        presetTime = 18.5
        Lighting.Brightness = 1.8
        Lighting.Ambient = Color3.fromRGB(105, 76, 74)
        Lighting.OutdoorAmbient = Color3.fromRGB(135, 91, 72)
        atm.Density = 0.2
        atm.Haze = 0.08
        atm.Color = Color3.fromRGB(255, 183, 126)
    elseif preset == "Overcast" then
        presetTime = 13
        Lighting.Brightness = 1.25
        Lighting.Ambient = Color3.fromRGB(105, 108, 115)
        Lighting.OutdoorAmbient = Color3.fromRGB(125, 128, 135)
        atm.Density = 0.32
        atm.Haze = 0.1
        atm.Color = Color3.fromRGB(195, 201, 210)
    elseif preset == "Night" then
        presetTime = 0
        Lighting.Brightness = 0.5
        Lighting.Ambient = Color3.fromRGB(35, 38, 58)
        Lighting.OutdoorAmbient = Color3.fromRGB(25, 30, 50)
        atm.Density = 0.35
        atm.Haze = 0
        atm.Color = Color3.fromRGB(30, 40, 80)
    elseif preset == "Fog" then
        presetTime = 15
        Lighting.Brightness = 1
        Lighting.FogStart = 0
        Lighting.FogEnd = 450
        Lighting.FogColor = Color3.fromRGB(190, 195, 200)
        atm.Density = 0.45
        atm.Haze = 0.11
        atm.Color = Color3.fromRGB(200, 200, 200)
    else
        return
    end

    if presetTime and not Config.Weather.TimeOfDayEnabled then
        Lighting.ClockTime = presetTime
    end
    Weather.ActivePreset = tostring(preset)
    Weather.updateStatus()
end

local Cam = {
    Active = false,
    Target = nil,
    Rotation = Vector2.new(0, 0),
    Position = Vector3.new(0, 0, 0),
    Distance = 12,
    Connections = {},
}

function Cam.targetPos()
    if not Cam.Target or not Cam.Target.Character then return nil end
    local head = Cam.Target.Character:FindFirstChild("Head")
    return head and head.Position or nil
end

function Cam.start(targetPlayer)
    local cam = workspace.CurrentCamera
    if not cam then return end
    Cam.Active = true
    Cam.Target = targetPlayer
    Cam.Rotation = Vector2.new(0, 0)
    Cam.Distance = 12
    local tpos = Cam.targetPos() or Vector3.new(0, 10, 0)
    Cam.Position = tpos + Vector3.new(0, 5, 0)
    pcall(function()
        local camScript = LP.PlayerScripts:FindFirstChild("PlayerModule")
        if camScript then
            local camModule = require(camScript)
            local controls = camModule:GetControls()
            if controls then controls:Disable() end
        end
    end)
    local mm = UserInputService.InputChanged:Connect(function(input)
        if not Cam.Active then return end
        if input.UserInputType == Enum.UserInputType.MouseMovement then
            Cam.Rotation = Cam.Rotation + Vector2.new(-input.Delta.X * 0.4, -input.Delta.Y * 0.4)
        elseif input.UserInputType == Enum.UserInputType.Touch then
            Cam.Rotation = Cam.Rotation + Vector2.new(-input.Delta.X * 0.6, -input.Delta.Y * 0.6)
        end
    end)
    table.insert(Cam.Connections, mm)
    local mw = UserInputService.InputChanged:Connect(function(input)
        if not Cam.Active then return end
        if input.UserInputType == Enum.UserInputType.MouseWheel then
            Cam.Distance = math.clamp(Cam.Distance - input.Position.Z * 2, 3, 60)
        end
    end)
    table.insert(Cam.Connections, mw)
    local rc = RunService.RenderStepped:Connect(function(dt)
        if not Cam.Active then return end
        local cam2 = workspace.CurrentCamera
        if not cam2 then return end
        local tpos = Cam.targetPos()
        if tpos then
            Cam.Position = Cam.Position:Lerp(tpos, math.min(dt * 12, 1))
        end
        local yaw = math.rad(Cam.Rotation.X)
        local pitch = math.rad(math.clamp(Cam.Rotation.Y, -80, 80))
        local offset = Vector3.new(math.sin(yaw) * math.cos(pitch), math.sin(pitch), math.cos(yaw) * math.cos(pitch)) * Cam.Distance
        local camPos = Cam.Position + offset
        cam2.CameraType = Enum.CameraType.Scriptable
        cam2.CFrame = CFrame.new(camPos, Cam.Position)
        cam2.Focus = CFrame.new(Cam.Position)
    end)
    table.insert(Cam.Connections, rc)
end

function Cam.stop()
    Cam.Active = false
    Cam.Target = nil
    for _, c in ipairs(Cam.Connections) do
        pcall(function() c:Disconnect() end)
    end
    Cam.Connections = {}
    pcall(function()
        local camScript = LP.PlayerScripts:FindFirstChild("PlayerModule")
        if camScript then
            local camModule = require(camScript)
            local controls = camModule:GetControls()
            if controls then controls:Enable() end
        end
    end)
    local cam = workspace.CurrentCamera
    if cam and LP.Character then
        local hum = LP.Character:FindFirstChildOfClass("Humanoid")
        if hum then
            cam.CameraType = Enum.CameraType.Custom
            cam.CameraSubject = hum
        end
    end
end

