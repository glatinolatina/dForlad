	local function normalizeQuestLocatorText(value)
		local text = string.lower(tostring(value or ""))
		text = text:gsub("[^%w%s]", " ")
		text = text:gsub("%s+", " ")
		return text:match("^%s*(.-)%s*$") or ""
	end

	local QUEST_LOCATOR_RULES = {
		{ Quest = "Homeless Man Jill [Lvl. 15+]", Patterns = {"homeless man jill", "gold coin", "gold coins", "collect 10 gold", "get 10 gold"} },
		{ Quest = "DIO [Lvl. 35+]", Patterns = {"defeat jotaro", "kill jotaro", "take down jotaro"} },
		{ Quest = "Doppio [Lvl. 30+]", Patterns = {"doppio", "kill dio", "defeat dio", "take down dio", "dio boss"} },
		{ Quest = "Abbacchio's Partner [Lvl 15+]", Patterns = {"abbacchio", "abbachio", "take down 5 alpha thugs", "alpha thug", "alpha thugs"} },
		{ Quest = "Deputy Bertrude [Lvl. 10+]", Patterns = {"deputy bertrude", "take down 5 corrupt police", "take down 5 currupt police", "5 corrupt police", "5 currupt police", "corrupt police", "currupt police"} },
		{ Quest = "William Zeppeli [Lvl. 25+]", Patterns = {"william zeppeli", "take down 3 vampires", "3 vampires", "vampire"} },
		{ Quest = "Dracula [Lvl. 20+]", Patterns = {"dracula", "take down 3 zombie", "take down 3 zombies", "3 zombie", "zombie henchman", "zombie"} },
		{ Quest = "Officer Sam [Lvl. 1+]", Patterns = {"officer sam", "take down 5 thugs", "5 thugs", "thug quest"} },
	}

	local function resolveQuestLocator(value)
		local text = normalizeQuestLocatorText(value)
		if text == "" then return nil end

		-- Objective wording must win over a substring match against a quest giver.
		-- In particular, "Defeat Jotaro" is the level-35 DIO quest; "Jotaro" by
		-- itself is the separate endgame quest that targets Heaven Ascension Dio.
		if text:find("defeat jotaro", 1, true)
			or text:find("kill jotaro", 1, true)
			or text:find("take down jotaro", 1, true) then
			return "DIO [Lvl. 35+]"
		end

		-- Exact quest-giver names first preserve ambiguous short names such as
		-- "Jotaro" without allowing them to swallow objective sentences.
		for _, questName in ipairs(QUEST_SELECTION_ORDER) do
			local normalizedName = normalizeQuestLocatorText(questName)
			if normalizedName ~= "" and text == normalizedName then
				return questName
			end
		end

		-- Some versions of the game put only the objective target in
		-- PlayerStats.CurrentQuest (for example, "Alpha Thug", "Vampire", or
		-- "Heaven Ascension Dio") rather than the quest giver's display name.
		-- Resolve exact objective values directly so an already accepted quest
		-- doesn't remain stuck in the unrecognized/sync state.
		for _, questName in ipairs(QUEST_SELECTION_ORDER) do
			local info = QuestInfo[questName]
			if info then
				local enemyName = info.Enemy and normalizeQuestLocatorText(info.Enemy) or ""
				local itemName = info.Item and normalizeQuestLocatorText(info.Item) or ""
				if (enemyName ~= "" and text == enemyName)
					or (itemName ~= "" and text == itemName) then
					return questName
				end
			end
		end

		for _, rule in ipairs(QUEST_LOCATOR_RULES) do
			for _, pattern in ipairs(rule.Patterns) do
				local normalizedPattern = normalizeQuestLocatorText(pattern)
				if normalizedPattern ~= "" and text:find(normalizedPattern, 1, true) then
					return rule.Quest
				end
			end
		end

		-- Retain matching for quest cards that append progress text after their full
		-- quest-giver name, but never use a bare "Jotaro" substring for this fallback.
		for _, questName in ipairs(QUEST_SELECTION_ORDER) do
			local normalizedName = normalizeQuestLocatorText(questName)
			if normalizedName ~= "" and normalizedName ~= "jotaro"
				and text:find(normalizedName, 1, true) then
				return questName
			end
		end
		return nil
	end

	local function locateActiveQuest()
		local texts = {}
		local function addText(value)
			if value == nil then return end
			local text = tostring(value)
			if text ~= "" then table.insert(texts, text) end
		end

		local stats = player and player:FindFirstChild("PlayerStats")
		local currentQuestValue = stats and stats:FindFirstChild("CurrentQuest")
		if currentQuestValue then addText(currentQuestValue.Value) end

		local playerGui = player and player:FindFirstChildOfClass("PlayerGui")
		local hud = playerGui and playerGui:FindFirstChild("HUD")
		local main = hud and hud:FindFirstChild("Main")
		local frames = main and main:FindFirstChild("Frames")
		local questFrame = frames and frames:FindFirstChild("Quest")
		local questList = questFrame and questFrame:FindFirstChild("Quests")
		local hasActiveQuestCard = false

		local function addInstanceText(instance, includeName)
			if not instance then return end
			local ancestor = instance
			while ancestor do
				if ancestor.Name == "Sample" then return end
				if ancestor:IsA("GuiObject") and not ancestor.Visible then return end
				if ancestor:IsA("ScreenGui") and not ancestor.Enabled then return end
				ancestor = ancestor.Parent
			end
			if includeName then addText(instance.Name) end
			if instance:IsA("TextLabel") or instance:IsA("TextButton") or instance:IsA("TextBox") then
				addText(instance.Text)
			elseif instance:IsA("ValueBase") then
				addText(instance.Value)
			end
		end

		-- Read actual quest cards first (names, objective labels, and progress text).
		-- This works even when CurrentQuest contains an objective instead of an NPC name.
		if questList then
			for _, item in ipairs(questList:GetChildren()) do
				if item.Name ~= "Sample" and item:IsA("GuiObject") and item.Visible then
					hasActiveQuestCard = true
					addInstanceText(item, true)
					for _, descendant in ipairs(item:GetDescendants()) do
						addInstanceText(descendant, true)
					end
				end
			end
		end

		-- Inspect the whole quest HUD before accepting any new quest. CurrentQuest
		-- can contain only an objective target (for example "Jotaro"), while the
		-- quest card contains the actual objective. Objective evidence takes priority
		-- over the quest-giver name so a current quest is resumed, not re-accepted.
		local allQuestText = table.concat(texts, " | ")
		local allQuestTextNormalized = normalizeQuestLocatorText(allQuestText)

		-- These explicit objectives disambiguate the two Jotaro-related quests.
		if allQuestTextNormalized:find("defeat jotaro", 1, true)
			or allQuestTextNormalized:find("kill jotaro", 1, true)
			or allQuestTextNormalized:find("take down jotaro", 1, true) then
			return "DIO [Lvl. 35+]", allQuestText, hasActiveQuestCard
		end
		if allQuestTextNormalized:find("heaven ascension dio", 1, true)
			or allQuestTextNormalized:find("heaven ascended dio", 1, true) then
			return "Jotaro", allQuestText, hasActiveQuestCard
		end

		-- Resolve other known objectives from the combined HUD text as well. Text
		-- can be split into separate labels, so checking each label alone misses
		-- quests such as Abbacchio's Alpha Thug objective.
		local objectiveChecks = {
			{ Quest = "Abbacchio's Partner [Lvl 15+]", Patterns = {"alpha thug", "take down 5 alpha thugs"} },
			{ Quest = "Deputy Bertrude [Lvl. 10+]", Patterns = {"corrupt police", "currupt police", "take down 5 corrupt police", "take down 5 currupt police"} },
			{ Quest = "Homeless Man Jill [Lvl. 15+]", Patterns = {"gold coin", "collect 10 gold", "get 10 gold"} },
			{ Quest = "Dracula [Lvl. 20+]", Patterns = {"zombie henchman", "take down 3 zombies", "take down 3 zombie", "zombie"} },
			{ Quest = "William Zeppeli [Lvl. 25+]", Patterns = {"take down 3 vampires", "3 vampires", "vampire"} },
			{ Quest = "Doppio [Lvl. 30+]", Patterns = {"defeat dio", "kill dio", "take down dio", "dio boss"} },
			{ Quest = "Officer Sam [Lvl. 1+]", Patterns = {"take down 5 thugs", "5 thugs", "thug quest"} },
		}
		for _, check in ipairs(objectiveChecks) do
			for _, pattern in ipairs(check.Patterns) do
				local normalizedPattern = normalizeQuestLocatorText(pattern)
				if normalizedPattern ~= "" and allQuestTextNormalized:find(normalizedPattern, 1, true) then
					return check.Quest, allQuestText, hasActiveQuestCard
				end
			end
		end

		for _, text in ipairs(texts) do
			local questName = resolveQuestLocator(text)
			if questName and QuestInfo[questName] then
				return questName, text, hasActiveQuestCard
			end
		end

		-- A title and its objective can be split across two labels, so also try their
		-- combined text as a fallback.
		local combined = table.concat(texts, " | ")
		local questName = resolveQuestLocator(combined)
		if questName and QuestInfo[questName] then return questName, combined, hasActiveQuestCard end
		return nil, combined, hasActiveQuestCard
	end


	-- Build evidence separately for each visible quest card. Do not concatenate
	-- multiple cards when deciding which quest is active: old cards can remain
	-- visible for a while and otherwise make the farm resume Abbacchio forever.
	local function getVisibleQuestCardTexts()
		local result = {}
		local playerGui = player and player:FindFirstChildOfClass("PlayerGui")
		local hud = playerGui and playerGui:FindFirstChild("HUD")
		local main = hud and hud:FindFirstChild("Main")
		local frames = main and main:FindFirstChild("Frames")
		local questFrame = frames and frames:FindFirstChild("Quest")
		local questList = questFrame and questFrame:FindFirstChild("Quests")
		if not questList then return result end

		local function visibleThroughParents(instance)
			local ancestor = instance
			while ancestor do
				if ancestor.Name == "Sample" then return false end
				if ancestor:IsA("GuiObject") and not ancestor.Visible then return false end
				if ancestor:IsA("ScreenGui") and not ancestor.Enabled then return false end
				ancestor = ancestor.Parent
			end
			return true
		end

		for _, card in ipairs(questList:GetChildren()) do
			if card.Name ~= "Sample" and card:IsA("GuiObject") and visibleThroughParents(card) then
				local pieces = {card.Name}
				if card:IsA("TextLabel") or card:IsA("TextButton") or card:IsA("TextBox") then
					if tostring(card.Text or "") ~= "" then table.insert(pieces, card.Text) end
				end
				for _, descendant in ipairs(card:GetDescendants()) do
					if visibleThroughParents(descendant)
						and (descendant:IsA("TextLabel") or descendant:IsA("TextButton") or descendant:IsA("TextBox"))
						and tostring(descendant.Text or "") ~= "" then
						table.insert(pieces, descendant.Text)
					end
				end
				local text = normalizeQuestLocatorText(table.concat(pieces, " "))
				if text ~= "" then table.insert(result, text) end
			end
		end
		return result
	end

	local QUEST_CARD_TARGET_PATTERNS = {
		["Officer Sam [Lvl. 1+]"] = {"take down 5 thugs", "take down 5 thug", "5 thugs", "thug quest"},
		["Deputy Bertrude [Lvl. 10+]"] = {"take down 5 corrupt police", "take down 5 currupt police", "5 corrupt police", "5 currupt police"},
		["Abbacchio's Partner [Lvl 15+]"] = {"take down 5 alpha thugs", "5 alpha thugs", "alpha thug"},
		["Homeless Man Jill [Lvl. 15+]"] = {"collect 10 gold coins", "collect 10 gold", "get 10 gold", "gold coin"},
		["Dracula [Lvl. 20+]"] = {"take down 3 zombies", "take down 3 zombie", "3 zombies", "3 zombie", "zombie henchman"},
		["William Zeppeli [Lvl. 25+]"] = {"take down 3 vampires", "3 vampires", "vampire"},
		["Doppio [Lvl. 30+]"] = {"defeat dio", "kill dio", "take down dio", "dio boss"},
		["DIO [Lvl. 35+]"] = {"defeat jotaro", "kill jotaro", "take down jotaro"},
		["Jotaro"] = {"heaven ascension dio", "heaven ascended dio"},
	}

	local function questCardMatchesTarget(cardText, target)
		if not target or not QuestInfo[target] then return false end
		local text = normalizeQuestLocatorText(cardText)
		if text == "" then return false end

		-- These two quests are intentionally disambiguated by the full objective,
		-- never by the word "Jotaro" alone.
		if target == "DIO [Lvl. 35+]" then
			if text:find("heaven ascension dio", 1, true) or text:find("heaven ascended dio", 1, true) then
				return false
			end
		elseif target == "Jotaro" then
			if text:find("defeat jotaro", 1, true) or text:find("kill jotaro", 1, true)
				or text:find("take down jotaro", 1, true) then
				return false
			end
		end

		local patterns = QUEST_CARD_TARGET_PATTERNS[target] or {}
		for _, phrase in ipairs(patterns) do
			if text:find(normalizeQuestLocatorText(phrase), 1, true) then return true end
		end

		-- A live card can show the quest-giver title instead of the full objective.
		local aliases = {
			["Officer Sam [Lvl. 1+]"] = {"officer sam"},
			["Deputy Bertrude [Lvl. 10+]"] = {"deputy bertrude"},
			["Abbacchio's Partner [Lvl 15+]"] = {"abbacchio", "abbachio"},
			["Homeless Man Jill [Lvl. 15+]"] = {"homeless man jill"},
			["Dracula [Lvl. 20+]"] = {"dracula"},
			["William Zeppeli [Lvl. 25+]"] = {"william zeppeli"},
			["Doppio [Lvl. 30+]"] = {"doppio"},
			["DIO [Lvl. 35+]"] = {"dio lvl 35"},
			["Jotaro"] = {"heaven ascension dio", "heaven ascended dio"},
		}
		for _, alias in ipairs(aliases[target] or {}) do
			if text:find(normalizeQuestLocatorText(alias), 1, true) then return true end
		end
		return false
	end

	local function selectedQuestHasActiveEvidence(target, raw)
		if not target or not QuestInfo[target] then return false end
		local rawText = normalizeQuestLocatorText(raw)
		local cards = getVisibleQuestCardTexts()
		for _, cardText in ipairs(cards) do
			-- Evaluate one card at a time. A stale Heaven Ascension Dio card must not
			-- cancel a different card that clearly says "Defeat Jotaro", and vice versa.
			if questCardMatchesTarget(cardText, target) then return true end
		end

		-- A CurrentQuest value that is exactly the configured objective is reliable
		-- for the unambiguous quests (Thug, Alpha Thug, DIO, etc.). Jotaro alone is
		-- ambiguous, so wait for its full HUD objective rather than guessing.
		if rawText == "jotaro" then return false end
		if rawText ~= "" then
			if rawText == normalizeQuestLocatorText(target) then return true end
			local data = QuestInfo[target]
			local enemy = data.Enemy and normalizeQuestLocatorText(data.Enemy) or ""
			local item = data.Item and normalizeQuestLocatorText(data.Item) or ""
			if (enemy ~= "" and rawText == enemy) or (item ~= "" and rawText == item) then
				return true
			end
			local rawResolved = QuestInfo[raw] and raw or resolveQuestLocator(raw)
			if rawResolved == target then return true end
		end
		return false
	end

	local function getPity()
		return PlayerPity.Value <= 0 and 1
			or math.clamp(1 + PlayerPity.Value / 25, 0, 10)
	end

	local function roundTwo(n)
		return math.floor(n * 100) / 100
	end

	local function FarmLoop()
		-- Flow: match the selected objective first, otherwise request that quest;
		-- after completion, turn it in and return to the same selected target.
		local lp = Players.LocalPlayer
		local playerGui = lp:WaitForChild("PlayerGui")
		local hud = playerGui:FindFirstChild("HUD")
		local completionConnection
		if hud then
			completionConnection = hud.ChildAdded:Connect(function(child)
				if child.Name == "QuestCompleted" then
					QuestRuntime.CompletionSeenAt = tick()
					FarmState.CompletedQuest = true
					getgenv().CompletedQuest = true
				end
			end)
		end

		task.spawn(function()
			while FarmState.Active do
				task.wait(2.5)
				if not FarmState.Active then break end
				local stats = lp:FindFirstChild("PlayerStats")
				local standValue = stats and stats:FindFirstChild("Stand")
				if isHandheldMethod() and not STAND_KEEPALIVE_EXCLUDED[standValue and standValue.Value or ""] then
					continue
				end
				local char = lp.Character
				if char then
					local ss = char:FindFirstChild("SummonedStand")
					if not (ss and ss.Value) then pcall(FarmUtil.EquipStand) end
				end
			end
		end)

		local masterConn = farmThrottledHeartbeat(function()
			if not FarmState.Active then return end
			local char = lp.Character
			if not char then return end
			local root = char:FindFirstChild("HumanoidRootPart")
			if not root then return end
			local enemy = FarmUtil.CurrentEnemy
			if enemy and enemy.Parent and enemy:FindFirstChild("HumanoidRootPart") then
				stickFarmPartsToNPC(char, enemy, isHandheldMethod())
			else
				zeroFarmVelocity(root)
			end
		end, 22, 45)

		local function rawQuestValue()
			local stats = lp:FindFirstChild("PlayerStats")
			local current = stats and stats:FindFirstChild("CurrentQuest")
			return current and tostring(current.Value or "") or ""
		end

		local function snapshotQuest()
			local state, statName, progress, maximum = GetQuestState()
			local raw = rawQuestValue()
			local locatedQuest, hudEvidence, hasActiveQuestCard = locateActiveQuest()
			local stats = lp:FindFirstChild("PlayerStats")
			local progressObject = stats and stats:FindFirstChild("QuestProgress")
			local maximumObject = stats and stats:FindFirstChild("QuestMaxProgress")
			progress = tonumber(progressObject and progressObject.Value) or tonumber(progress) or 0
			maximum = tonumber(maximumObject and maximumObject.Value) or tonumber(maximum) or 0

			if raw ~= "" and QuestRuntime.IgnoreHUDQuestName then
				QuestRuntime.IgnoreHUDQuestName = nil
				QuestRuntime.IgnoreHUDUntil = 0
			end

			local manualTarget = not getgenv().AutoSelectBestQuest
				and (QuestRuntime.ManualQuest or getgenv().SelectedQuest) or nil
			if not QuestInfo[manualTarget] then manualTarget = nil end

			-- The selected target is matched against each active card separately.
			-- Never let an unrelated/stale Abbacchio card override the server's live
			-- CurrentQuest value, and never infer a selected quest from text combined
			-- across several different cards.
			local manualEvidenceMatch = manualTarget and selectedQuestHasActiveEvidence(manualTarget, raw) or false
			if raw == "" and manualTarget and QuestRuntime.IgnoreHUDQuestName == manualTarget then
				-- Turn-in clears CurrentQuest before the old card leaves the HUD. Ignore
				-- that card so the same manual quest can be accepted again after completion.
				manualEvidenceMatch = false
			end
			local rawNormalized = normalizeQuestLocatorText(raw)
			local rawResolved = nil
			if raw ~= "" then
				rawResolved = QuestInfo[raw] and raw or resolveQuestLocator(raw)
			end

			-- "Jotaro" by itself is ambiguous between the level-35 objective and the
			-- separate Heaven Ascension Dio quest. Wait for the active card's full
			-- objective instead of picking either quest from that single word.
			if rawNormalized == "jotaro" then
				local cards = getVisibleQuestCardTexts()
				local cardDerivedQuest = nil
				for _, cardText in ipairs(cards) do
					if cardText:find("defeat jotaro", 1, true) or cardText:find("kill jotaro", 1, true)
						or cardText:find("take down jotaro", 1, true) then
						cardDerivedQuest = "DIO [Lvl. 35+]"
						break
					elseif cardText:find("heaven ascension dio", 1, true)
						or cardText:find("heaven ascended dio", 1, true) then
						cardDerivedQuest = "Jotaro"
						break
					end
				end
				if cardDerivedQuest then
					rawResolved = cardDerivedQuest
				else
					return "sync", nil, progress, maximum, raw
				end
			end

			if raw == "" then
				if manualTarget then
					if manualEvidenceMatch then
						if maximum > 0 and progress >= maximum then
							return "complete", manualTarget, progress, maximum, raw
						end
						return "active", manualTarget, progress, maximum, raw
					end
					-- Manual mode means a stale card for another quest is not proof that
					-- the chosen quest is active. Treat it as no matching quest and request
					-- the selected giver rather than farming the stale card's enemy.
					return "none", nil, progress, maximum, raw
				end

				local located = locatedQuest
				if located and QuestInfo[located] then
					if QuestRuntime.IgnoreHUDQuestName == located then
						return "none", nil, progress, maximum, raw
					elseif QuestRuntime.IgnoreHUDQuestName and located ~= QuestRuntime.IgnoreHUDQuestName then
						QuestRuntime.IgnoreHUDQuestName = nil
						QuestRuntime.IgnoreHUDUntil = 0
					end
					local stats = lp:FindFirstChild("PlayerStats")
					local progressValue = stats and stats:FindFirstChild("QuestProgress")
					local maximumValue = stats and stats:FindFirstChild("QuestMaxProgress")
					progress = tonumber(progressValue and progressValue.Value) or 0
					maximum = tonumber(maximumValue and maximumValue.Value) or 0
					if maximum > 0 and progress >= maximum then
						return "complete", located, progress, maximum, raw
					end
					return "active", located, progress, maximum, raw
				end
				if hasActiveQuestCard then
					return "sync", nil, progress, maximum, raw
				end
				return "none", nil, progress, maximum, raw
			end

			-- Start with the live server value. A HUD result is allowed to refine it
			-- only when the server value is unresolvable; it is not allowed to replace
			-- a valid CurrentQuest with an unrelated visible quest card.
			local resolved = rawResolved
			if manualTarget and manualEvidenceMatch then
				if rawNormalized == "jotaro" or not resolved then
					resolved = manualTarget
				end
			end
			if not resolved and not manualTarget and locatedQuest and QuestInfo[locatedQuest] then
				resolved = locatedQuest
			end

			if not resolved then
				if manualTarget then
					-- A non-empty but unfamiliar CurrentQuest should not permanently block
					-- a manual choice. No selected-objective match means try the selection.
					return "none", nil, progress, maximum, raw
				end
			return "sync", nil, progress, maximum, raw
			end

			if maximum > 0 and progress >= maximum then
				state = "complete"
			else
				state = "active"
			end
			return state, resolved, progress, maximum, raw
		end

		local function isValidQuest(name)
			return type(name) == "string" and QuestInfo[name] ~= nil and name ~= "No quests available"
		end

		local function chooseNextQuest()
			local chosen
			if getgenv().AutoSelectBestQuest == true then
				chosen = GetBestQuestForLevel(GetPlayerLevel())
			else
				chosen = QuestRuntime.ManualQuest or getgenv().SelectedQuest
			end
			if not isValidQuest(chosen) then chosen = GetLowestLevelQuest() end
			if isValidQuest(chosen) then return chosen end
			return nil
		end

		local function refreshQuestProgressLabel(state, questName, progress, maximum, raw)
			if tick() - (QuestRuntime.LastStatusUpdate or 0) < 0.4 then return end
			QuestRuntime.LastStatusUpdate = tick()
			UpdateQuestStatusLabel()
			local detail
			if state == "none" then
				detail = "No active quest. Next target: " .. tostring(chooseNextQuest() or "waiting for an available quest")
			elseif state == "sync" then
				detail = "Reading active quest data: " .. tostring(raw or "waiting for server")
			elseif maximum > 0 then
				detail = tostring(questName) .. "  •  " .. tostring(progress) .. "/" .. tostring(maximum)
			else
				detail = tostring(questName) .. "  •  progress syncing"
			end
			pcall(function()
				if QuestProgressLabel and QuestProgressLabel.SetDesc then QuestProgressLabel:SetDesc(detail) end
			end)
		end

		local function attemptAcceptQuest(questName, forceReplace)
			local now = tick()
			if not isValidQuest(questName) then return false end
			if now - (QuestRuntime.LastAcceptAttempt or 0) < 0.5 then return false end
			if QuestRuntime.LastAcceptQuest ~= questName then
				QuestRuntime.LastAcceptQuest = questName
				QuestRuntime.AcceptRetryAt = 0
				QuestRuntime.AcceptFailureCount = 0
			end
			if now < (QuestRuntime.AcceptRetryAt or 0) then
				setQuestStatus("Waiting to retry", "Waiting before reopening " .. tostring(questName) .. ". The last dialogue did not confirm an accepted quest.")
				return false
			end
			QuestRuntime.LastAcceptAttempt = now

			-- Recheck the quest immediately before interacting. This avoids starting a
			-- stale target's dialogue if the server has just synced another active quest.
			local beforeState, beforeName, beforeProgress, beforeMaximum, beforeRaw = snapshotQuest()
			if beforeState == "sync" and beforeRaw ~= "" then
				-- Never open another quest dialogue while the server says a quest is
				-- already active but its name is still ambiguous. Wait for the objective
				-- HUD to identify it; this prevents duplicate acceptance on quest startup.
				setQuestStatus("Waiting for active quest sync", "The server already has an active quest (" .. tostring(beforeRaw) .. "). Waiting to identify it instead of accepting another quest.")
				QuestRuntime.AcceptRetryAt = now + 0.75
				return false
			end

			if beforeState ~= "none" and beforeState ~= "sync" then
				if forceReplace and beforeName ~= questName then
					setQuestStatus("Switching to selected quest", "The current quest is " .. tostring(beforeName) .. ". Requesting your manually selected target: " .. tostring(questName) .. ".")
				else
					if beforeName then
						setQuestStatus("Resuming active quest", "The server already reports " .. tostring(beforeName) .. ". Not opening another quest dialogue.")
					end
					QuestRuntime.AcceptRetryAt = now + 1
					return false
				end
			end

			local dialogues = workspace:FindFirstChild("Dialogues")
			local npc = dialogues and dialogues:FindFirstChild(questName)
			if not npc then
				setQuestStatus("Waiting for NPC", "Auto target: " .. tostring(questName) .. ". Waiting for this quest giver to replicate instead of falling back to Dracula.")
				QuestRuntime.AcceptRetryAt = now + 1.5
				return false
			end

			QuestRuntime.LastRawQuest = rawQuestValue()
			setQuestStatus("Accepting quest", "Talking to " .. tostring(questName) .. ". Waiting for the server to confirm acceptance before doing anything else.")
			local ok, result = pcall(GetQuest, npc, forceReplace == true)
			if not ok then
				warn("[Quest Farm] Accept attempt failed: " .. tostring(result))
			elseif result == true and QuestRuntime.IgnoreHUDQuestName == questName then
				-- We have now interacted with the same quest giver again, so its card can
				-- represent the new quest instead of the completed quest left behind.
				QuestRuntime.IgnoreHUDQuestName = nil
				QuestRuntime.IgnoreHUDUntil = 0
			end

			-- Allow the quest state and HUD a little time to replicate. Do not reopen
			-- the same NPC every two seconds when the server hasn't acknowledged it.
			local confirmDeadline = tick() + 1.8
			local stateAfter, nameAfter = "none", nil
			repeat
				task.wait(0.12)
				stateAfter, nameAfter = snapshotQuest()
			until (stateAfter ~= "none" and stateAfter ~= "sync") or not FarmState.Active or tick() >= confirmDeadline

			if stateAfter ~= "none" and stateAfter ~= "sync" then
				if nameAfter == questName then
					QuestRuntime.AcceptFailureCount = 0
					QuestRuntime.AcceptRetryAt = 0
					QuestRuntime.OverrideRequested = false
					setQuestStatus("Quest accepted", "Confirmed " .. tostring(questName) .. ". Starting its objective now.")
					return true
				end
				-- For a forced manual switch, an unrelated active quest is not a
				-- successful result. Fall through to the retry/backoff path below.
			end

			QuestRuntime.AcceptFailureCount = math.min((QuestRuntime.AcceptFailureCount or 0) + 1, 4)
			local backoff = math.min(2 ^ QuestRuntime.AcceptFailureCount, 16)
			QuestRuntime.AcceptRetryAt = tick() + backoff
			setQuestStatus("Quest not confirmed", "The server did not confirm " .. tostring(questName) .. ". Waiting " .. tostring(backoff) .. " seconds before retrying to avoid reopening the dialogue repeatedly.")
			if tick() - (QuestRuntime.LastFailureNotice or 0) > 8 then
				QuestRuntime.LastFailureNotice = tick()
				notify("Quest Farm", "Quest acceptance wasn't confirmed. The farm will wait before retrying.", 4, "warning")
			end
			return false
		end

		local function attemptTurnIn(questName, itemObjective)
			if tick() - (QuestRuntime.LastTurnInAttempt or 0) < 2.0 then return false end
			QuestRuntime.LastTurnInAttempt = tick()
			local dialogues = workspace:FindFirstChild("Dialogues")
			local npc = dialogues and dialogues:FindFirstChild(questName)
			if not npc then
				setQuestStatus("Waiting to turn in", "Quest is complete, but its giver isn't available: " .. tostring(questName))
				return false
			end
			setQuestStatus("Turning in quest", "Claiming the reward from " .. tostring(questName) .. ".")
			local beforeProgress, beforeMaximum = 0, 0
			local beforeState, beforeName, p, m = snapshotQuest()
			beforeProgress, beforeMaximum = p or 0, m or 0
			local beforeRaw = rawQuestValue()
			local ok, clickedTurnIn = pcall(TurnInQuest, npc)
			if not ok then
				warn("[Quest Farm] Turn-in attempt failed: " .. tostring(clickedTurnIn))
			elseif clickedTurnIn == true then
				-- If CurrentQuest clears before the Quest HUD card animates away, ignore only
				-- that old card briefly. The target selector remains independent of it.
				QuestRuntime.IgnoreHUDQuestName = questName
				QuestRuntime.IgnoreHUDUntil = math.huge
				QuestRuntime.LastTurnInClickAt = tick()
			end
			local deadline = tick() + 3.2
			local cleared = false
			repeat
				task.wait(0.16)
				local afterState, afterName, afterProgress, afterMaximum = snapshotQuest()
				local afterRaw = rawQuestValue()
				if afterState == "none" or (beforeRaw ~= "" and afterRaw == "")
					or (afterRaw == "" and QuestRuntime.CompletionSeenAt ~= nil
						and tick() - QuestRuntime.CompletionSeenAt < 10) then
					cleared = true
				elseif afterName and afterName ~= questName then
					cleared = true
				elseif afterName == questName and beforeMaximum > 0 and beforeProgress >= beforeMaximum
					and afterState == "active" and afterMaximum > 0 and afterProgress < afterMaximum then
					cleared = true
				end
			until cleared or not FarmState.Active or tick() >= deadline
			if cleared then
				FarmState.CompletedQuest = false
				getgenv().CompletedQuest = false
				FarmState.CurrentQuest = nil
				QuestRuntime.ActiveQuest = nil
				setQuestStatus("Quest turned in", "Reward claimed. Selecting the next quest using " .. (getgenv().AutoSelectBestQuest and "Auto Select Best Quest" or "your manual selection") .. ".")
				return true
			end
			if FarmState.Active then
				setQuestStatus("Turn-in pending", (itemObjective and "Items are collected. " or "The objective is complete. ") .. "Waiting for the server to clear the quest before accepting another.")
			end
			return false
		end

		while FarmState.Active do
			if not IsPlayerReady() then
				setQuestStatus("Waiting for character", "Waiting for your character to finish spawning before continuing Quest Farm.")
				task.wait(0.3)
				continue
			end

			local state, questName, progress, maximum, raw = snapshotQuest()
			refreshQuestProgressLabel(state, questName, progress, maximum, raw)

			if state == "none" then
				FarmState.CompletedQuest = false
				getgenv().CompletedQuest = false
				local nextQuest = chooseNextQuest()
				if not nextQuest then
					setQuestStatus("No quest available", "No known quest is available right now. Waiting for quest NPCs to load.")
					task.wait(0.5)
					continue
				end
				FarmState.CurrentQuest = nextQuest
				QuestRuntime.ActiveQuest = nil
				if tick() - (QuestRuntime.LastAcceptAttempt or 0) >= 2.0 then
					attemptAcceptQuest(nextQuest)
				else
					setQuestStatus("Waiting for acceptance", "Target: " .. nextQuest .. ". Waiting for the previous dialogue/server response before retrying.")
					task.wait(0.15)
				end
				task.wait(0.12)
				continue
			end

			if state == "sync" or not questName then
				-- A non-empty CurrentQuest is proof that the player already has a quest.
				-- If its label has not synchronized, do not accept anything else yet.
				-- snapshotQuest will map it as soon as the objective text becomes readable.
				if raw and raw ~= "" then
					setQuestStatus("Synchronizing active quest", "The server already reports an active quest (" .. tostring(raw) .. "). Waiting to identify its objective before opening another quest dialogue.")
				else
					setQuestStatus("Synchronizing quest", "An active quest card is visible, but its objective hasn't synchronized yet. Waiting instead of accepting another quest.")
				end
				task.wait(0.25)
				continue
			end

			local manualTarget = not getgenv().AutoSelectBestQuest and chooseNextQuest() or nil
			if manualTarget and questName ~= manualTarget then
				local activeData = QuestInfo[questName]
				if state == "complete" or (maximum > 0 and progress >= maximum) then
					FarmState.CurrentQuest = questName
					QuestRuntime.ActiveQuest = questName
					FarmState.CompletedQuest = true
					getgenv().CompletedQuest = true
					attemptTurnIn(questName, activeData and activeData.Item ~= nil)
				else
					QuestRuntime.OverrideRequested = true
					FarmState.CurrentQuest = manualTarget
					if tick() - (QuestRuntime.LastAcceptAttempt or 0) >= 2.0 then
						attemptAcceptQuest(manualTarget, true)
					else
						setQuestStatus("Switching to selected quest", "Your manual target is " .. tostring(manualTarget) .. ". Waiting to request it; the farm will not attack " .. tostring(questName) .. " in the meantime.")
					end
				end
				task.wait(0.12)
				continue
			end

			QuestRuntime.OverrideRequested = false
			local questData = QuestInfo[questName]
			if not questData then
				setQuestStatus("Unknown active quest", "The game reports an active quest that isn't mapped yet: " .. tostring(raw) .. ". Waiting without opening another dialogue.")
				task.wait(0.35)
				continue
			end

			FarmState.CurrentQuest = questName
			QuestRuntime.ActiveQuest = questName
			QuestRuntime.LastRawQuest = raw
			local isStatComplete = maximum > 0 and progress >= maximum
			if state == "complete" or isStatComplete then
				FarmState.CompletedQuest = true
				getgenv().CompletedQuest = true
				attemptTurnIn(questName, questData.Item ~= nil)
				task.wait(0.12)
				continue
			end

			FarmState.CompletedQuest = false
			getgenv().CompletedQuest = false
			if questData.Enemy then
				setQuestStatus("Farming objective", questName .. "  •  " .. tostring(progress) .. "/" .. tostring(maximum) .. "  •  target: " .. tostring(questData.Enemy))
				local enemy = findAliveQuestEnemy(questData.Enemy)
				if enemy then
					local ok, err = pcall(FarmUtil.Kill, enemy)
					if not ok then
						warn("[Quest Farm] Combat iteration failed: " .. tostring(err))
						setQuestStatus("Recovering combat", "An enemy action failed. The farm will reacquire the target and continue.")
						task.wait(0.25)
					end
				else
					task.wait(0.2)
				end
			elseif questData.Item then
				local count = FarmUtil.CountItem(questData.Item)
				if count >= questData.Amount then
					setQuestStatus("Items collected", questName .. "  •  " .. tostring(count) .. "/" .. tostring(questData.Amount) .. "  •  turning in reward")
					attemptTurnIn(questName, true)
				else
					setQuestStatus("Collecting items", questName .. "  •  " .. tostring(count) .. "/" .. tostring(questData.Amount) .. " " .. tostring(questData.Item))
					local spawns = workspace:FindFirstChild("Item_Spawns")
					local spawnParent = spawns and spawns:FindFirstChild("Items")
					local targetItem = nil
					if spawnParent then
						for _, item in ipairs(spawnParent:GetChildren()) do
							if item.Name == questData.Item then targetItem = item break end
						end
					end
					if targetItem then
						local ok, err = pcall(FarmUtil.Collect, targetItem)
						if not ok then warn("[Quest Farm] Item collection failed: " .. tostring(err)) end
					else
						task.wait(0.25)
					end
				end
			else
				setQuestStatus("Unknown objective", "No farming handler exists for " .. tostring(questName) .. ".")
				task.wait(0.3)
			end

			task.wait(math.max(0.1, tonumber(FarmConfig.QuestCheckDelay) or 0.35))
		end

		FarmUtil.CurrentEnemy = nil
		stopQuestNPCView()
		pcall(function() if masterConn then masterConn:Disconnect() end end)
		pcall(function() if completionConnection then completionConnection:Disconnect() end end)
	end

	local noQuestKillEnabled = false
	local noQuestKillTarget = "Vampire"

	local function killNPCNoQuest(npcName)
		local enemy = nil
		local containers = { workspace:FindFirstChild("Living") or workspace }
		if workspace:FindFirstChild("Mob_Spawns2") then
			table.insert(containers, workspace.Mob_Spawns2)
		end
		for _, container in pairs(containers) do
			for _, child in pairs(container:GetDescendants()) do
				if child.Name == npcName or questEnemyNameMatches(child.Name, npcName) then
					local h = child:FindFirstChild("Health")
					local hrp = child:FindFirstChild("HumanoidRootPart")
					if h and h.Value > 0 and hrp then
						enemy = child
						break
					end
				end
			end
			if enemy then break end
		end
		if not enemy then return end

		local enemyHRP = enemy:FindFirstChild("HumanoidRootPart")
		if not enemyHRP then return end

		local handheld = isHandheldMethod()
		if not handheld then
			FarmUtil.EquipStand()
			task.wait(0.3)
		end

		local running = true
		startQuestNPCView(enemy)
		local moneyConn
		local dropMoney = Players.LocalPlayer.PlayerGui:FindFirstChild("HUD")
			and Players.LocalPlayer.PlayerGui.HUD:FindFirstChild("Main")
			and Players.LocalPlayer.PlayerGui.HUD.Main:FindFirstChild("DropMoney")
			and Players.LocalPlayer.PlayerGui.HUD.Main.DropMoney:FindFirstChild("Money")
		if dropMoney then
			moneyConn = dropMoney.ChildAdded:Connect(function(child)
				if tonumber(string.match(child.Name, "%d+")) then
					running = false
					if moneyConn then moneyConn:Disconnect() moneyConn = nil end
				end
			end)
		end

		local heartbeat = farmThrottledHeartbeat(function()
			if not running or not noQuestKillEnabled then return end
			if enemy.Parent == nil then return end
			local currentHRP = enemy:FindFirstChild("HumanoidRootPart")
			if not currentHRP then return end
			local char = Players.LocalPlayer.Character
			if not char then return end
			local hHRP = char:FindFirstChild("HumanoidRootPart")
			if not hHRP then return end

			local hum = char:FindFirstChildWhichIsA("Humanoid")
			if not (hum and hum.Health > 0) then return end
			stickFarmPartsToNPC(char, enemy, handheld)
		end, 22, 45)

		while running and noQuestKillEnabled do
			if enemy.Parent == nil or not enemy:FindFirstChild("HumanoidRootPart") then
				running = false
				break
			end
			local currentEnemyHRP = enemy:FindFirstChild("HumanoidRootPart")
			local h = enemy:FindFirstChild("Health")
			if h and h.Value <= 0 then
				running = false
				break
			end
			local char = Players.LocalPlayer.Character
			local hum = char and char:FindFirstChildWhichIsA("Humanoid")
			if hum and hum.Health > 0 then
				if handheld or char:FindFirstChild("StandMorph") then
					FarmUtil.UseMove("m1")
					local remote = char:FindFirstChild("RemoteEvent")
					if remote then
						if game:GetService("CollectionService"):HasTag(enemy, "Blocking") then
							remote:FireServer("InputBegan", { Input = Enum.KeyCode.R })
						end
						local keys = getgenv().AutoUseStandSkillKeys or {"E"}
						for _, keyName in ipairs(keys) do
							local skillKey = keyName and Enum.KeyCode[keyName] or nil
							if skillKey then
								remote:FireServer("InputBegan", { Input = skillKey })
							end
						end
					end
				else
					task.wait(0.3)
				end
			else
				Players.LocalPlayer.CharacterAdded:Wait()
				if not handheld then FarmUtil.EquipStand() end
				task.wait(0.3)
			end
			task.wait(farmStepWait())
		end
		if moneyConn then
			moneyConn:Disconnect()
			moneyConn = nil
		end

		local bufUntil = tick() + NPC_KILL_POST_BUFFER_SEC
		while noQuestKillEnabled and tick() < bufUntil do
			local char = Players.LocalPlayer.Character
			local hum = char and char:FindFirstChildWhichIsA("Humanoid")
			if hum and hum.Health > 0 then
				if char:FindFirstChild("StandMorph") then
					FarmUtil.UseMove("m1")
					local remote = char:FindFirstChild("RemoteEvent")
					if remote then
						local keys = getgenv().AutoUseStandSkillKeys or {"E"}
						for _, keyName in ipairs(keys) do
							local skillKey = keyName and Enum.KeyCode[keyName] or nil
							if skillKey then
								remote:FireServer("InputBegan", { Input = skillKey })
							end
						end
					end
				else
					task.wait(0.3)
				end
			end
			task.wait(farmStepWait())
		end

		if heartbeat then heartbeat:Disconnect() end
		stopQuestNPCView()
		local char = Players.LocalPlayer.Character
		if char then
			clearFocusCam(char)
			for _, v in pairs(char:GetDescendants()) do
				if v:IsA("BasePart") then v.CanCollide = true end
			end
		end
	end

