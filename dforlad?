		["DIO [Lvl. 35+]"] = 35,
		-- Jotaro is the final/endgame quest in this catalog and its display name
		-- does not include a level tag, so explicitly place it after the level-35 quest.
		["Jotaro"] = 50,
	}

	local QUEST_SELECTION_ORDER = {
		"Officer Sam [Lvl. 1+]",
		"Deputy Bertrude [Lvl. 10+]",
		"Abbacchio's Partner [Lvl 15+]",
		"Homeless Man Jill [Lvl. 15+]",
		"Dracula [Lvl. 20+]",
