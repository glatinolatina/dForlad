        if state and currentStandName() ~= "Mr. President" then
            kidnapEnabled = false
            if kidnapToggle then pcall(function() kidnapToggle:Set(false) end) end
            notifyTroll("Mr. President", "Equip Mr. President before enabling this feature.", "Warning")
            return
        end
        kidnapEnabled = state == true
        kidnapLoopToken += 1
        local token = kidnapLoopToken
        if not kidnapEnabled then
            if kidnapCleanup then pcall(kidnapCleanup) end
            restoreKidnapCollision()
            local character = LP.Character
            local root = character and character:FindFirstChild("HumanoidRootPart")
            if root then pcall(function() root.Anchored = false end) end
            notifyTroll("Mr. President", "Kidnapper disabled.", "Info")
