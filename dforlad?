	local function GetQuestState()
		local player = GetPlayer()
		if not player or not player:FindFirstChild("PlayerStats") then
			return "none", nil, 0, 0
		end
		local stats = player.PlayerStats
		local currentQuest = stats:FindFirstChild("CurrentQuest")
		local questProgress = stats:FindFirstChild("QuestProgress")
		local questMax = stats:FindFirstChild("QuestMaxProgress")
		local rawQuest = currentQuest and tostring(currentQuest.Value or "") or ""
		if rawQuest ~= "" then
			-- CurrentQuest is the server-backed source of truth. Some quests populate
			-- QuestProgress / QuestMaxProgress a little later (or omit one of them),
			-- so missing progress objects must not make an accepted quest look absent.
			local progress = tonumber(questProgress and questProgress.Value) or 0
			local maxProgress = tonumber(questMax and questMax.Value) or 0
			if maxProgress > 0 and progress >= maxProgress then
				return "complete", currentQuest.Value, progress, maxProgress
			end
			return "active", currentQuest.Value, progress, maxProgress
		end
		return "none", nil, 0, 0
	end

