	local function GetAllNPCs()
		local NPCs, seen = {}, {}
		local living = workspace:FindFirstChild("Living")
		if living then
			for _, npc in ipairs(living:GetChildren()) do
				if npc:FindFirstChild("Spawn") and not seen[npc.Name] then
					seen[npc.Name] = true
					table.insert(NPCs, npc.Name)
				end
			end
		end
		table.sort(NPCs)
		return NPCs
	end

