        end
        notifyTroll("Mr. President", "Kidnapper enabled.", "Success")
        task.spawn(function()
            local lastAction = 0
            while kidnapEnabled and kidnapLoopToken == token do
                task.wait(0.1)
                if os.clock() - lastAction >= 14 and not kidnapCooldownActive() then
                    local target = getKidnapTarget()
                    if target and target.Character then
                        lastAction = os.clock()
                        performKidnap(target, token)
                    end
                end
            end
        end)
    end,
})

