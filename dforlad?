	-- Keep the full quest catalog independent from which quest-giver models happen
	-- to be replicated at script startup. ParsedQuests is a UI/catalog list, not a
	-- list of currently streamed NPCs; otherwise Auto Select can get stuck on Dracula
	-- simply because higher-level givers had not replicated yet.
	local QUEST_LEVEL_REQUIREMENTS = {
		["Officer Sam [Lvl. 1+]"] = 1,
		["Deputy Bertrude [Lvl. 10+]"] = 10,
		["Abbacchio's Partner [Lvl 15+]"] = 15,
